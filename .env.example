# Example environment variables - copy to .env and fill in your actual values

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=dqrj6xsjs
CLOUDINARY_API_KEY=your_actual_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_actual_cloudinary_api_secret_here

# Site Configuration
SITE_URL=https://lateoptics.netlify.app
SITE_TITLE=lateoptics
SITE_DESCRIPTION=Photography Portfolio

# Email/Contact
CONTACT_EMAIL=your_email@example.com

# Analytics (optional)
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Social Media API Keys (optional)
# INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
# GITHUB_TOKEN=your_github_personal_access_token

# Development
NODE_ENV=development
