---
import { buildResponsiveImageUrls, buildCloudinaryUrl } from '../utils/cloudinary';

export interface Props {
  images: Array<{
    src: string; // This will now be the Cloudinary public ID
    alt: string;
    title?: string;
    aspect?: 'tall' | 'wide' | 'square';
  }>;
}

const { images } = Astro.props;

// Function to get random aspect ratio for masonry effect
function getAspectClass(aspect?: 'tall' | 'wide' | 'square', index = 0) {
  if (aspect) {
    switch (aspect) {
      case 'tall': return 'aspect-[3/4]';
      case 'wide': return 'aspect-[4/3]';
      case 'square': return 'aspect-square';
    }
  }
  
  // If no aspect specified, create variety based on index
  const patterns = ['aspect-[3/4]', 'aspect-[4/3]', 'aspect-square', 'aspect-[5/4]', 'aspect-[16/9]'];
  return patterns[index % patterns.length];
}
---

<div class="columns-1 md:columns-2 lg:columns-3 xl:columns-4 gap-6 space-y-6">
  {images.map((image, index) => {
    const { src, srcset } = buildResponsiveImageUrls(image.src);
    const thumbnailSrc = buildCloudinaryUrl(image.src, { 
      width: 600, 
      height: 400, 
      crop: 'fill', 
      quality: 'auto',
      format: 'auto'
    });
    
    return (
      <div class="break-inside-avoid group cursor-pointer overflow-hidden rounded-lg shadow-md hover:shadow-xl transition-all duration-300 transform hover:scale-[1.02]">
        <div class="relative bg-gray-100">
          <img
            src={thumbnailSrc}
            srcset={srcset}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, (max-width: 1280px) 33vw, 25vw"
            alt={image.alt}
            class="gallery-thumbnail w-full h-auto object-cover transition-transform duration-300"
            loading="lazy"
            data-index={index}
            data-full-src={src}
          />
          <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-30 transition-opacity duration-300 flex items-center justify-center">
          </div>
        </div>
      </div>
    )
  })}
</div>
