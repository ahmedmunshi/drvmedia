---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-50 border-t border-gray-200 mt-16">
  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Navigation Links -->
      <div class="text-center md:text-left">
        <h3 class="text-sm font-semibold text-gray-900 tracking-wider uppercase mb-4">Navigation</h3>
        <ul class="space-y-3">
          <li>
            <a href="/" class="text-gray-600 hover:text-gray-900 transition-colors text-sm">Gallery</a>
          </li>
          <li>
            <a href="/about" class="text-gray-600 hover:text-gray-900 transition-colors text-sm">About</a>
          </li>
        </ul>
      </div>

      <!-- Connect -->
      <div class="text-center md:text-left">
        <h3 class="text-sm font-semibold text-gray-900 tracking-wider uppercase mb-4">Connect</h3>
        <ul class="space-y-3">
          <li>
            <a href="https://instagram.com/drvmedia" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900 transition-colors text-sm">Instagram</a>
          </li>
          <li>
            <a href="mailto:info@drv-media.com" class="text-gray-600 hover:text-gray-900 transition-colors text-sm">Email</a>
          </li>
        </ul>
      </div>

      <!-- Info -->
      <div class="text-center md:text-left">
        <h3 class="text-sm font-semibold text-gray-900 tracking-wider uppercase mb-4">Services</h3>
        <ul class="space-y-3">
          <li>
            <span class="text-gray-600 text-sm">Automotive Photography & Videography</span>
          </li>
          <li>
            <span class="text-gray-600 text-sm">Custom Content Creation</span>
          </li>
          <li>
            <span class="text-gray-600 text-sm">Event Coverage</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="mt-8 pt-8 border-t border-gray-300">
      <div class="text-center">
        <p class="text-gray-600 text-sm mb-2">
          © {currentYear} DRV Media. All rights reserved.
        </p>
        <p class="text-gray-500 text-xs">
          Based in Lusaka, Zambia • Available for automotive events and custom shoots
        </p>
      </div>
    </div>
  </div>
</footer>
