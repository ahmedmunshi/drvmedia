---
import { buildCloudinaryUrl } from '../utils/cloudinary';

export interface Props {
  images: Array<{
    src: string; // This will now be the Cloudinary public ID
    alt: string;
    title?: string;
  }>;
}

const { images } = Astro.props;
---

<!-- Lightbox Modal -->
<div id="lightbox" class="fixed inset-0 bg-black bg-opacity-95 hidden z-50 flex items-center justify-center">
  <div class="relative w-full h-full flex items-center justify-center px-4 py-8">
    <!-- Close button -->
    <button 
      id="lightbox-close"
      class="absolute top-6 right-6 text-white hover:text-gray-300 z-20 p-3 bg-black bg-opacity-50 rounded-full transition-all duration-200 hover:bg-opacity-70"
      aria-label="Close lightbox"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    
    <!-- Previous button - positioned absolutely within the lightbox container -->
    <button 
      id="lightbox-prev"
      class="text-white hover:text-gray-300 p-3 md:p-4 bg-black bg-opacity-50 rounded-full transition-all duration-200 hover:bg-opacity-70 hover:scale-110 min-w-[48px] md:min-w-[56px] min-h-[48px] md:min-h-[56px] flex items-center justify-center"
      aria-label="Previous image"
    >
      <svg class="w-5 h-5 md:w-6 md:h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>
    
    <!-- Next button - positioned absolutely within the lightbox container -->
    <button 
      id="lightbox-next"
      class="text-white hover:text-gray-300 p-3 md:p-4 bg-black bg-opacity-50 rounded-full transition-all duration-200 hover:bg-opacity-70 hover:scale-110 min-w-[48px] md:min-w-[56px] min-h-[48px] md:min-h-[56px] flex items-center justify-center"
      aria-label="Next image"
    >
      <svg class="w-5 h-5 md:w-6 md:h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
    
    <!-- Image container with consistent positioning -->
    <div class="absolute inset-0 flex items-center justify-center" style="padding: 60px 70px;">
      <div class="relative w-full h-full flex items-center justify-center min-h-[200px]">
        <img 
          id="lightbox-image"
          class="max-w-full max-h-full object-contain shadow-2xl transition-opacity duration-300"
          src=""
          alt=""
          style="opacity: 0; min-height: 200px;"
        />
        
        <!-- Placeholder/skeleton when image is loading -->
        <div 
          id="lightbox-skeleton" 
          class="absolute inset-0 flex items-center justify-center opacity-1 transition-opacity duration-300"
          style="background: rgba(40, 40, 40, 0.8); backdrop-filter: blur(10px); min-height: 200px;"
        >
          <div class="text-gray-300 text-center">
            <div class="w-16 h-16 mx-auto mb-4 border-2 border-gray-500 border-t-white rounded-full animate-spin"></div>
            <p class="text-sm font-light">Loading image...</p>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Image info - positioned absolutely within the lightbox container -->
    <div class="absolute bottom-4 md:bottom-6 left-4 md:left-6 right-4 md:right-6 text-white z-30">
      <div class="flex justify-between items-end">
        <div id="lightbox-title" class="flex-1">
          <p class="text-base md:text-lg font-medium"></p>
        </div>
        <div class="ml-4">
          <span id="lightbox-counter" class="text-xs md:text-sm bg-black bg-opacity-50 px-3 md:px-4 py-1 md:py-2 rounded-full"></span>
        </div>
      </div>
    </div>
    
    <!-- Loading indicator - positioned absolutely within the lightbox container -->
    <div id="lightbox-loading" class="absolute inset-0 flex items-center justify-center bg-black bg-opacity-75 hidden z-25">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-white"></div>
    </div>
  </div>
</div>

<style>
  /* Ensure lightbox arrows maintain consistent positioning */
  #lightbox {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    z-index: 50 !important;
  }
  
  #lightbox-prev,
  #lightbox-next {
    position: fixed !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    z-index: 60 !important;
    pointer-events: auto !important;
  }
  
  #lightbox-prev {
    left: 0.5rem !important;
  }
  
  #lightbox-next {
    right: 0.5rem !important;
  }
  
  /* Responsive positioning */
  @media (min-width: 768px) {
    #lightbox-prev {
      left: 1.5rem !important;
    }
    
    #lightbox-next {
      right: 1.5rem !important;
    }
  }
  
  /* Ensure image container doesn't interfere with arrow positioning */
  #lightbox .relative {
    pointer-events: none;
  }
  
  #lightbox img {
    pointer-events: auto;
  }
  
  /* Prevent content from pushing arrows around */
  #lightbox > div:first-child {
    position: relative !important;
    width: 100% !important;
    height: 100% !important;
  }
  
  /* Force arrows to stay in position regardless of content */
  #lightbox-prev,
  #lightbox-next {
    width: 48px !important;
    height: 48px !important;
    min-width: 48px !important;
    min-height: 48px !important;
  }
  
  @media (min-width: 768px) {
    #lightbox-prev,
    #lightbox-next {
      width: 56px !important;
      height: 56px !important;
      min-width: 56px !important;
      min-height: 56px !important;
    }
  }
</style>

<script define:vars={{ images }}>
  // Import Cloudinary utility (we'll need to make this available in the client)
  function buildCloudinaryUrl(publicId, options = {}) {
    const cloudName = 'dqrj6xsjs'; // Your cloud name
    const {
      width,
      height,
      quality = 'auto',
      format = 'auto',
      crop = 'fill',
      gravity = 'auto',
      dpr = 'auto',
      blur
    } = options;

    let transformations = [];
    
    transformations.push(`q_${quality}`);
    transformations.push(`f_${format}`);
    transformations.push(`dpr_${dpr}`);
    
    if (blur) {
      transformations.push(`e_blur:${blur}`);
    }
    
    if (width || height) {
      let sizeTransform = '';
      if (width) sizeTransform += `w_${width}`;
      if (height) sizeTransform += `${width ? ',' : ''}h_${height}`;
      sizeTransform += `,c_${crop}`;
      if (gravity && crop === 'fill') sizeTransform += `,g_${gravity}`;
      transformations.push(sizeTransform);
    }

    const baseUrl = `https://res.cloudinary.com/${cloudName}/image/upload`;
    const transformString = transformations.join(',');
    
    // Images are uploaded directly to root, not in a folder
    return `${baseUrl}/${transformString}/${publicId}`;
  }

  let currentImageIndex = 0;
  let isLightboxOpen = false;
  
  function showLoading() {
    const loading = document.getElementById('lightbox-loading');
    const skeleton = document.getElementById('lightbox-skeleton');
    if (loading) loading.classList.remove('hidden');
    if (skeleton) skeleton.style.opacity = '1';
  }
  
  function hideLoading() {
    const loading = document.getElementById('lightbox-loading');
    const skeleton = document.getElementById('lightbox-skeleton');
    if (loading) loading.classList.add('hidden');
    if (skeleton) skeleton.style.opacity = '0';
  }
  
  function openLightbox(index) {
    const lightbox = document.getElementById('lightbox');
    const image = document.getElementById('lightbox-image');
    const title = document.getElementById('lightbox-title');
    const counter = document.getElementById('lightbox-counter');
    const skeleton = document.getElementById('lightbox-skeleton');
    
    if (!lightbox || !image || !title || !counter) return;
    
    currentImageIndex = index;
    isLightboxOpen = true;
    
    const currentImage = images[currentImageIndex];
    
    // Show skeleton immediately and hide image
    if (skeleton) skeleton.style.opacity = '1';
    image.style.opacity = '0';
    image.src = ''; // Clear any previous image
    
    // Generate optimized image URL for lightbox based on screen size
    const screenWidth = window.innerWidth;
    const screenHeight = window.innerHeight;
    // Use 90% of screen size instead of device pixel ratio to avoid huge images
    const maxWidth = Math.min(screenWidth * 0.9, 1400); // Cap at 1400px
    const maxHeight = Math.min(screenHeight * 0.9, 900); // Cap at 900px
    
    const lightboxImageSrc = buildCloudinaryUrl(currentImage.src, {
      width: Math.floor(maxWidth),
      height: Math.floor(maxHeight),
      quality: 'auto:good',
      format: 'auto',
      crop: 'fit' // Maintain aspect ratio
    });
    
    // Load the high-quality image
    const highQualityImg = new Image();
    highQualityImg.onload = () => {
      image.src = lightboxImageSrc;
      image.alt = currentImage.alt;
      image.style.opacity = '1';
      if (skeleton) skeleton.style.opacity = '0';
    };
    highQualityImg.onerror = () => {
      // On error, show a fallback or keep skeleton visible
      console.error('Failed to load lightbox image:', lightboxImageSrc);
      if (skeleton) {
        const skeletonText = skeleton.querySelector('p');
        if (skeletonText) skeletonText.textContent = 'Failed to load image';
      }
    };
    highQualityImg.src = lightboxImageSrc;
    
    // Update title
    const titleP = title.querySelector('p');
    if (titleP) {
      titleP.textContent = currentImage.title || currentImage.alt;
    }
    
    // Update counter
    counter.textContent = `${currentImageIndex + 1} / ${images.length}`;
    
    // Show lightbox
    lightbox.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    
    // Focus management for accessibility
    lightbox.focus();
  }
  
  function closeLightbox() {
    const lightbox = document.getElementById('lightbox');
    if (lightbox && isLightboxOpen) {
      lightbox.classList.add('hidden');
      document.body.style.overflow = 'auto';
      isLightboxOpen = false;
      hideLoading();
    }
  }
  
  function showPrevImage() {
    if (!isLightboxOpen) return;
    currentImageIndex = currentImageIndex > 0 ? currentImageIndex - 1 : images.length - 1;
    updateLightboxImage();
  }
  
  function showNextImage() {
    if (!isLightboxOpen) return;
    currentImageIndex = currentImageIndex < images.length - 1 ? currentImageIndex + 1 : 0;
    updateLightboxImage();
  }
  
  function updateLightboxImage() {
    const image = document.getElementById('lightbox-image');
    const title = document.getElementById('lightbox-title');
    const counter = document.getElementById('lightbox-counter');
    const skeleton = document.getElementById('lightbox-skeleton');
    
    if (!image || !title || !counter) return;
    
    const currentImage = images[currentImageIndex];
    
    // Show skeleton and hide image during loading
    if (skeleton) {
      skeleton.style.opacity = '1';
      const skeletonText = skeleton.querySelector('p');
      if (skeletonText) skeletonText.textContent = 'Loading image...';
    }
    image.style.opacity = '0';
    image.src = ''; // Clear previous image
    
    // Generate optimized image URL for lightbox based on screen size
    const screenWidth = window.innerWidth;
    const screenHeight = window.innerHeight;
    // Use 90% of screen size instead of device pixel ratio to avoid huge images
    const maxWidth = Math.min(screenWidth * 0.9, 1400); // Cap at 1400px
    const maxHeight = Math.min(screenHeight * 0.9, 900); // Cap at 900px
    
    const lightboxImageSrc = buildCloudinaryUrl(currentImage.src, {
      width: Math.floor(maxWidth),
      height: Math.floor(maxHeight),
      quality: 'auto:good',
      format: 'auto',
      crop: 'fit' // Maintain aspect ratio
    });
    
    // Load the high-quality image
    const highQualityImg = new Image();
    highQualityImg.onload = () => {
      image.src = lightboxImageSrc;
      image.alt = currentImage.alt;
      image.style.opacity = '1';
      if (skeleton) skeleton.style.opacity = '0';
    };
    highQualityImg.onerror = () => {
      console.error('Failed to load lightbox image:', lightboxImageSrc);
      if (skeleton) {
        const skeletonText = skeleton.querySelector('p');
        if (skeletonText) skeletonText.textContent = 'Failed to load image';
      }
    };
    highQualityImg.src = lightboxImageSrc;
    
    // Update title
    const titleP = title.querySelector('p');
    if (titleP) {
      titleP.textContent = currentImage.title || currentImage.alt;
    }
    
    // Update counter
    counter.textContent = `${currentImageIndex + 1} / ${images.length}`;
  }
  
  // Ensure DOM is loaded before attaching event listeners
  document.addEventListener('DOMContentLoaded', function() {
    let eventListenersAttached = false;
    
    function attachImageEventListeners() {
      if (eventListenersAttached) return;
      
      // Gallery thumbnails click handlers
      const thumbnails = document.querySelectorAll('.gallery-thumbnail');
      
      if (thumbnails.length === 0) {
        // If thumbnails aren't ready yet, try again in a bit
        setTimeout(attachImageEventListeners, 200);
        return;
      }
      
      thumbnails.forEach((thumbnail, index) => {
        thumbnail.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          openLightbox(index);
        });
        
        // Also handle clicks on parent container
        const container = thumbnail.closest('.group');
        if (container) {
          container.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            openLightbox(index);
          });
        }
      });
      
      eventListenersAttached = true;
    }
    
    // Start trying to attach event listeners immediately
    attachImageEventListeners();
    
    // Also listen for when the image grid becomes visible
    const imageGrid = document.getElementById('image-grid');
    if (imageGrid) {
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
            const opacity = parseFloat(imageGrid.style.opacity || '0');
            if (opacity > 0.5 && !eventListenersAttached) {
              attachImageEventListeners();
            }
          }
        });
      });
      
      observer.observe(imageGrid, { attributes: true, attributeFilter: ['style'] });
    }
    
    // Lightbox controls
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const lightbox = document.getElementById('lightbox');
    
    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (prevBtn) prevBtn.addEventListener('click', showPrevImage);
    if (nextBtn) nextBtn.addEventListener('click', showNextImage);
    
    // Close on background click
    if (lightbox) {
      lightbox.addEventListener('click', function(e) {
        if (e.target === lightbox) {
          closeLightbox();
        }
      });
    }
    
    // Keyboard navigation
    document.addEventListener('keydown', function(e) {
      if (isLightboxOpen) {
        e.preventDefault();
        switch(e.key) {
          case 'Escape':
            closeLightbox();
            break;
          case 'ArrowLeft':
          case 'a':
          case 'A':
            showPrevImage();
            break;
          case 'ArrowRight':
          case 'd':
          case 'D':
          case ' ':
            showNextImage();
            break;
        }
      }
    });
    
    // Touch/swipe support for mobile
    let touchStartX = 0;
    let touchEndX = 0;
    
    if (lightbox) {
      lightbox.addEventListener('touchstart', function(e) {
        touchStartX = e.changedTouches[0].screenX;
      });
      
      lightbox.addEventListener('touchend', function(e) {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
      });
    }
    
    function handleSwipe() {
      const swipeThreshold = 50;
      const diff = touchStartX - touchEndX;
      
      if (Math.abs(diff) > swipeThreshold && isLightboxOpen) {
        if (diff > 0) {
          // Swiped left - show next image
          showNextImage();
        } else {
          // Swiped right - show previous image
          showPrevImage();
        }
      }
    }
  });
</script>
