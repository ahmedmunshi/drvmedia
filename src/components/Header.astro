---
const currentPath = Astro.url.pathname;
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-[100] transition-all duration-300 ease-out" style="position: fixed !important; top: 0 !important; z-index: 100 !important; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-bottom: 1px solid rgba(0, 0, 0, 0.1); box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo - Always visible -->
      <div class="flex items-center">
        <a href="/" class="flex items-center space-x-2">
          <img src="/newlogo-dark.png" alt="drvmedia Logo" class="h-12 w-12" />
          <span class="text-2xl font-semibold text-gray-900 tracking-normal">
            <span style="font-family: 'Nunito Sans', sans-serif; font-weight: 600; letter-spacing: 0.02em;">drv</span><span style="font-family: 'Times New Roman', serif; font-weight: 400; font-style: italic; letter-spacing: 0.02em;">media</span>
          </span>
        </a>
      </div>
      
      <!-- Desktop Navigation - Hidden on mobile -->
      <div class="hidden md:flex items-center space-x-8">
        <div class="flex items-baseline space-x-8">
          <a 
            href="/" 
            class={`px-3 py-2 rounded-md text-sm font-thin tracking-wide transition-colors ${
              currentPath === '/' 
                ? 'text-gray-900 bg-gray-100' 
                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'
            }`}
            style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
          >
            Gallery
          </a>
          <a 
            href="/about" 
            class={`px-3 py-2 rounded-md text-sm font-thin tracking-wide transition-colors ${
              currentPath === '/about' 
                ? 'text-gray-900 bg-gray-100' 
                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'
            }`}
            style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
          >
            About
          </a>
        </div>
        
        <!-- Desktop Book Session button -->
        <div class="flex items-center space-x-4">
          <button 
            id="connect-btn"
            class="px-3 py-2 text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-md text-sm font-thin transition-colors tracking-wide"
            style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
          >
            Connect
          </button>
          <a 
            href="/booking"
            class="px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-thin hover:bg-gray-800 transition-colors tracking-wide"
            style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
          >
            Book Session
          </a>
        </div>
      </div>
      
      <!-- Mobile Book Session button - Always visible on mobile -->
      <div class="md:hidden flex items-center space-x-2">
        <button 
          id="connect-btn-mobile"
          class="px-3 py-2 text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-md text-sm font-thin transition-colors tracking-wide"
          style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
        >
          Connect
        </button>
        <a 
          href="/booking"
          class="px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-thin hover:bg-gray-800 transition-colors tracking-wide"
          style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
        >
          Book
        </a>
      </div>
    </div>
  </nav>
</header>

<!-- Connect Sidebar -->
<div id="connect-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-[60] hidden"></div>
<div id="connect-sidebar" class="fixed right-0 top-0 w-80 max-w-[80vw] h-full bg-white z-[70] transform translate-x-full transition-transform duration-300 shadow-xl">
  <div class="p-6">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-xl font-thin text-gray-900 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;">Let's Connect</h2>
      <button id="connect-close" class="p-1 hover:bg-gray-100 rounded">
        <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    
    <div class="space-y-3">
      <a 
        href="https://instagram.com/ahmedmunshi" 
        target="_blank"
        class="group flex items-center p-4 border border-gray-200 rounded-lg hover:border-gray-300 hover:bg-gray-50 transition-all duration-200"
      >
        <div class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center mr-3 group-hover:bg-gray-200 transition-colors">
          <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="font-medium text-gray-900 text-sm mb-0.5" style="font-family: 'Poppins', sans-serif;">Instagram</div>
          <div class="text-sm text-gray-600 truncate" style="font-family: 'Poppins', sans-serif;">@ahmedmunshi</div>
        </div>
        <svg class="w-4 h-4 text-gray-400 group-hover:text-gray-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a 
        href="mailto:ahmed@ahmedmunshi.com"
        class="group flex items-center p-4 border border-gray-200 rounded-lg hover:border-gray-300 hover:bg-gray-50 transition-all duration-200"
      >
        <div class="w-10 h-10 bg-gray-100 rounded-full flex items-center justify-center mr-3 group-hover:bg-gray-200 transition-colors">
          <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="font-medium text-gray-900 text-sm mb-0.5" style="font-family: 'Poppins', sans-serif;">Email</div>
          <div class="text-sm text-gray-600 truncate" style="font-family: 'Poppins', sans-serif;">ahmed@ahmedmunshi.com</div>
        </div>
        <svg class="w-4 h-4 text-gray-400 group-hover:text-gray-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
    <div class="mt-8 pt-6 border-t border-gray-100">
      <p class="text-sm text-gray-600 mb-3 leading-relaxed" style="font-family: 'Poppins', sans-serif;">
        Interested in collaboration or photography services?
      </p>
      <div class="text-xs text-gray-500 leading-relaxed" style="font-family: 'Poppins', sans-serif;">
        Available for automotive, portrait, and event photography.
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Header scroll effect
    const header = document.getElementById('main-header');
    let lastScrollY = 0;
    
    function handleHeaderScroll() {
      const scrollY = window.scrollY;
      
      if (!header) return;
      
      // Define the scroll range for the transition (0-150px)
      const transitionRange = 150;
      const scrollProgress = Math.min(scrollY / transitionRange, 1);
      
      // Start solid (95% opacity) and transition to translucent (5% opacity)
      const startOpacity = 0.95; // Solid at top
      const endOpacity = 0.05;   // Translucent when scrolled
      const backgroundOpacity = startOpacity - (startOpacity - endOpacity) * scrollProgress;
      
      // Border transitions from solid to translucent
      const startBorderOpacity = 0.1;  // Visible border at top
      const endBorderOpacity = 0.05;   // Subtle border when scrolled
      const borderOpacity = startBorderOpacity - (startBorderOpacity - endBorderOpacity) * scrollProgress;
      
      // Apply the transitions
      header.style.background = `rgba(255, 255, 255, ${backgroundOpacity})`;
      header.style.backdropFilter = 'blur(20px)';
      header.style.borderBottom = `1px solid rgba(0, 0, 0, ${borderOpacity})`;
      
      // Shadow fades out as we scroll
      if (scrollY < transitionRange) {
        const shadowOpacity = 0.1 * (1 - scrollProgress); // Start with shadow, fade out
        header.style.boxShadow = `0 1px 3px 0 rgba(0, 0, 0, ${shadowOpacity}), 0 1px 2px 0 rgba(0, 0, 0, ${shadowOpacity * 0.6})`;
      } else {
        header.style.boxShadow = 'none';
      }
      
      lastScrollY = scrollY;
    }
    
    // Initial call
    handleHeaderScroll();
    
    // Add scroll listener
    window.addEventListener('scroll', handleHeaderScroll, { passive: true });
    
    // Connect sidebar functionality
    const connectBtn = document.getElementById('connect-btn');
    const connectBtnMobile = document.getElementById('connect-btn-mobile');
    const connectSidebar = document.getElementById('connect-sidebar');
    const connectOverlay = document.getElementById('connect-overlay');
    const connectClose = document.getElementById('connect-close');
    
    function openConnectSidebar() {
      if (connectSidebar && connectOverlay) {
        connectSidebar.classList.remove('translate-x-full');
        connectOverlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }
    
    function closeConnectSidebar() {
      if (connectSidebar && connectOverlay) {
        connectSidebar.classList.add('translate-x-full');
        connectOverlay.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }
    
    if (connectBtn) {
      connectBtn.addEventListener('click', openConnectSidebar);
    }
    
    if (connectBtnMobile) {
      connectBtnMobile.addEventListener('click', openConnectSidebar);
    }
    
    if (connectClose) {
      connectClose.addEventListener('click', closeConnectSidebar);
    }
    
    if (connectOverlay) {
      connectOverlay.addEventListener('click', closeConnectSidebar);
    }
    
    // ESC key to close connect sidebar
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeConnectSidebar();
      }
    });
  });
</script>
