---
const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-[100] bg-white shadow-sm border-b border-gray-200" style="position: fixed !important; top: 0 !important; z-index: 100 !important;">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo - Always visible -->
      <div class="flex items-center">
        <a href="/" class="flex items-center space-x-3">
          <img src="/image.png" alt="Late Optics Logo" class="h-8 w-8" />
          <span class="text-2xl font-semibold text-gray-900 tracking-normal" style="font-family: 'Poppins', sans-serif; font-weight: 600; letter-spacing: 0.02em;">Late Optics</span>
        </a>
      </div>
      
      <!-- Desktop Navigation - Hidden on mobile -->
      <div class="hidden md:flex items-center space-x-8">
        <div class="flex items-baseline space-x-8">
          <a 
            href="/" 
            class={`px-3 py-2 rounded-md text-sm font-thin tracking-wide transition-colors ${
              currentPath === '/' 
                ? 'text-gray-900 bg-gray-100' 
                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'
            }`}
            style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
          >
            Gallery
          </a>
          <a 
            href="/about" 
            class={`px-3 py-2 rounded-md text-sm font-thin tracking-wide transition-colors ${
              currentPath === '/about' 
                ? 'text-gray-900 bg-gray-100' 
                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50'
            }`}
            style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
          >
            About
          </a>
        </div>
        
        <!-- Desktop Connect button -->
        <button 
          id="connect-btn"
          class="px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-thin hover:bg-gray-800 transition-colors tracking-wide"
          style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
        >
          Connect
        </button>
      </div>
      
      <!-- Mobile Connect button - Always visible on mobile -->
      <div class="md:hidden">
        <button 
          id="connect-btn-mobile"
          class="px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-thin hover:bg-gray-800 transition-colors tracking-wide"
          style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
        >
          Connect
        </button>
      </div>
    </div>
  </nav>
</header>

<!-- Connect Sidebar -->
<div id="connect-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-[60] hidden"></div>
<div id="connect-sidebar" class="fixed right-0 top-0 w-80 max-w-[80vw] h-full bg-white z-[70] transform translate-x-full transition-transform duration-300 shadow-xl">
  <div class="p-6">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-xl font-thin text-gray-900 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;">Connect</h2>
      <button id="connect-close" class="p-1 hover:bg-gray-100 rounded">
        <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    
    <div class="space-y-4">
      <a 
        href="https://instagram.com/lateoptics" 
        target="_blank"
        class="flex items-center px-4 py-3 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-lg hover:from-purple-600 hover:to-pink-600 transition-all"
      >
        <svg class="w-5 h-5 mr-3" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        <div>
          <div class="font-thin tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;">Instagram</div>
          <div class="text-sm opacity-90 font-thin tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.04em;">@lateoptics</div>
        </div>
      </a>
      
      <a 
        href="mailto:lateoptics@gmail.com"
        class="flex items-center px-4 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-all"
      >
        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        <div>
          <div class="font-thin tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;">Email</div>
          <div class="text-sm opacity-90 font-thin tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.04em;">lateoptics@gmail.com</div>
        </div>
      </a>
    </div>
    
    <div class="mt-8 pt-6 border-t border-gray-200">
      <p class="text-sm text-gray-600 mb-4">
        Interested in collaboration or automotive photography services? Let's connect!
      </p>
      <div class="text-xs text-gray-500">
        Available for automotive events, car shows, and custom shoots within Lusaka.
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Connect sidebar functionality
    const connectBtn = document.getElementById('connect-btn');
    const connectBtnMobile = document.getElementById('connect-btn-mobile');
    const connectSidebar = document.getElementById('connect-sidebar');
    const connectOverlay = document.getElementById('connect-overlay');
    const connectClose = document.getElementById('connect-close');
    
    function openConnectSidebar() {
      if (connectSidebar && connectOverlay) {
        connectSidebar.classList.remove('translate-x-full');
        connectOverlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }
    
    function closeConnectSidebar() {
      if (connectSidebar && connectOverlay) {
        connectSidebar.classList.add('translate-x-full');
        connectOverlay.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }
    
    if (connectBtn) {
      connectBtn.addEventListener('click', openConnectSidebar);
    }
    
    if (connectBtnMobile) {
      connectBtnMobile.addEventListener('click', openConnectSidebar);
    }
    
    if (connectClose) {
      connectClose.addEventListener('click', closeConnectSidebar);
    }
    
    if (connectOverlay) {
      connectOverlay.addEventListener('click', closeConnectSidebar);
    }
    
    // ESC key to close connect sidebar
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeConnectSidebar();
      }
    });
  });
</script>
