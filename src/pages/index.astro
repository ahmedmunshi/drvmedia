---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { cloudinaryGalleryImages } from '../data/cloudinaryImages';

// Use Cloudinary images
const portfolioImages = cloudinaryGalleryImages;

// SEO optimized metadata
const seoTitle = "LateOptics - Professional Automotive Photography Portfolio";
const seoDescription = "LateOptics professional automotive photography featuring stunning car photography, automotive art, and creative automotive visuals. View our complete automotive photography portfolio.";
const seoKeywords = "LateOptics, Late Optics, automotive photography, car photography, professional automotive photographer, automotive art, car photos, automotive visuals, automotive portfolio";
---

<Layout 
  title={seoTitle} 
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/logo.png"
>
  <Header />
  
  <main class="min-h-screen">
    <!-- Mobile Navigation - Gallery and About buttons that disappear on scroll -->
    <div id="mobile-nav" class="lg:hidden fixed top-16 left-0 right-0 z-40 bg-white shadow-sm transition-transform duration-300">
      <div class="flex justify-center items-center py-3 space-x-4">
        <!-- Gallery button -->
        <button 
          id="mobile-gallery-btn"
          class="px-4 py-2 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-md text-sm font-thin tracking-wide transition-colors"
          style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
        >
          Gallery
        </button>
        <!-- About button -->
        <a 
          href="/about" 
          class="px-4 py-2 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-md text-sm font-thin tracking-wide transition-colors"
          style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
        >
          About
        </a>
      </div>
    </div>

    <!-- Portfolio Hero Section - Positioned in flow -->
    <section class="pt-16 lg:pt-16 pb-32 lg:pb-40 relative">
      <div id="portfolio-hero" class="fixed left-0 right-0 top-32 lg:top-24 flex items-center justify-center pointer-events-none z-10 transition-opacity duration-300">
        <div class="text-center">
          <h1 class="text-4xl lg:text-5xl font-thin text-gray-900 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
          
            Automotive Photography Portfolio
          </h1>
        </div>
      </div>
    </section>

    <!-- Gallery Grid -->
    <section class="py-8 lg:py-8" role="main" aria-label="Automotive Photography Gallery">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div id="gallery-container" style="min-height: 400px; opacity: 0; transition: opacity 0.5s ease;">
          <!-- Gallery will be populated by JavaScript -->
        </div>
      </div>
    </section>
  </main>
  
  <!-- Custom Lightbox -->
  <div id="lightbox" class="hidden fixed inset-0 bg-black bg-opacity-90 z-[9999] flex items-center justify-center" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="lightbox-title">
    <div class="relative max-w-full max-h-full p-4">
      <!-- Close button -->
      <button 
        id="lightbox-close"
        class="absolute top-4 right-4 text-white hover:text-gray-300 z-[10000] bg-black bg-opacity-50 rounded-full p-2 transition-colors duration-200"
        aria-label="Close lightbox"
        type="button"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      
      <!-- Previous button -->
      <button 
        id="lightbox-prev"
        class="absolute left-4 top-1/2 transform -translate-y-1/2 text-white hover:text-gray-300 z-[10000] bg-black bg-opacity-50 rounded-full p-2 transition-colors duration-200"
        aria-label="Previous image"
        type="button"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      
      <!-- Next button -->
      <button 
        id="lightbox-next"
        class="absolute right-4 top-1/2 transform -translate-y-1/2 text-white hover:text-gray-300 z-[10000] bg-black bg-opacity-50 rounded-full p-2 transition-colors duration-200"
        aria-label="Next image"
        type="button"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
      
      <!-- Image container -->
      <div class="flex flex-col items-center">
        <img 
          id="lightbox-image"
          src=""
          alt=""
          class="max-w-full max-h-[80vh] object-contain transition-opacity duration-200"
          style="opacity: 1;"
        />
        
        <!-- Image counter only (removed title) -->
        <div class="mt-4 text-center text-white">
          <div id="lightbox-counter" class="text-sm opacity-75"></div>
        </div>
      </div>
    </div>
  </div>
  
  <script define:vars={{ portfolioImages }}>
    // Import Cloudinary utility client-side with better optimization
    function buildCloudinaryUrl(publicId, options = {}) {
      const baseUrl = 'https://res.cloudinary.com/dqrj6xsjs/image/upload';
      
      // Simplified transformations for testing
      const transformations = [
        'f_auto',
        'q_auto',
        options.width ? `w_${options.width}` : 'w_400'
      ].join(',');
      
      return `${baseUrl}/${transformations}/${publicId}`;
    }
    
    document.addEventListener('DOMContentLoaded', function() {
      const galleryContainer = document.getElementById('gallery-container');
      const portfolioHero = document.getElementById('portfolio-hero');
      const mobileNav = document.getElementById('mobile-nav');
      
      console.log('DOMContentLoaded - galleryContainer:', galleryContainer);
      console.log('portfolioImages available:', typeof portfolioImages !== 'undefined', portfolioImages?.length);
      
      // EDIT THESE PIXEL VALUES TO CONTROL FADE BEHAVIOR
      const FADE_START_PIXEL = 5; // Change this number to adjust when fade begins
      const FADE_AMOUNT_PIXEL = 25; // Change this number to adjust fade duration/distance
      const NAV_HIDE_PIXEL = 100; // When to hide mobile navigation
      
      // Variables for scroll speed detection
      let lastScrollTop = 0;
      let scrollSpeed = 0;
      let lastScrollTime = Date.now();
      
      // Scroll animation for portfolio hero and mobile navigation
      function handleScroll() {
        const scrolled = window.scrollY;
        const currentTime = Date.now();
        const timeDiff = currentTime - lastScrollTime;
        
        // Calculate scroll speed (pixels per millisecond)
        scrollSpeed = Math.abs(scrolled - lastScrollTop) / timeDiff;
        lastScrollTop = scrolled;
        lastScrollTime = currentTime;
        
        // Portfolio hero fade behavior - enhanced with scroll speed
        if (scrolled > FADE_START_PIXEL) {
          const fadeProgress = (scrolled - FADE_START_PIXEL) / FADE_AMOUNT_PIXEL;
          
          // Speed multiplier: faster scrolling = faster fade
          const speedMultiplier = Math.min(scrollSpeed * 2, 3); // Cap at 3x speed
          const enhancedFadeProgress = fadeProgress * (1 + speedMultiplier);
          
          const opacity = Math.max(0, 1 - enhancedFadeProgress);
          
          if (portfolioHero) {
            portfolioHero.style.opacity = opacity;
          }
        } else {
          if (portfolioHero) {
            portfolioHero.style.opacity = '1';
          }
        }
        
        // Mobile navigation hide behavior
        if (mobileNav) {
          if (scrolled > NAV_HIDE_PIXEL) {
            mobileNav.style.transform = 'translateY(-100%)';
          } else {
            mobileNav.style.transform = 'translateY(0)';
          }
        }
      }
      
      // Add scroll listener
      window.addEventListener('scroll', handleScroll);
      
      // Initialize hero visibility
      if (portfolioHero) {
        portfolioHero.style.display = 'flex';
        portfolioHero.style.opacity = '1';
      }
      
      function displayImages() {
        console.log('displayImages called, portfolioImages length:', portfolioImages.length);
        console.log('First image:', portfolioImages[0]);
        
        // Initialize gallery container with stable opacity
        if (galleryContainer) {
          galleryContainer.style.opacity = '0';
          galleryContainer.style.minHeight = '400px'; // Prevent initial layout shift
        }
        
        // Create new ImageGrid HTML using optimized Cloudinary URLs with stable layout
        const gridHTML = `
          <div class="columns-1 sm:columns-2 md:columns-3 lg:columns-4 xl:columns-4 gap-3 md:gap-6 space-y-3 md:space-y-6">
            ${portfolioImages.map((image, index) => {
              // Use larger thumbnails to give landscape images more presence
              const thumbnailUrl = buildCloudinaryUrl(image.src, { width: 400, quality: 'auto:good', crop: 'fit' });
              
              // Create a low-quality placeholder for immediate loading and layout stability
              const placeholderUrl = buildCloudinaryUrl(image.src, { 
                width: 50, 
                quality: 30, 
                format: 'auto',
                blur: 15 
              });
              
              console.log(`Image ${index}: ${image.src} -> ${thumbnailUrl}`);
              return `
                <div class="break-inside-avoid group cursor-pointer overflow-hidden rounded-lg shadow-md hover:shadow-xl transition-all duration-300 transform hover:scale-[1.02] mb-3 md:mb-0">
                  <div class="relative bg-gray-100" style="min-height: 200px;">
                    <img
                      src="${placeholderUrl}"
                      data-src="${thumbnailUrl}"
                      alt="${image.alt}"
                      class="gallery-thumbnail w-full h-auto object-cover transition-all duration-500 blur-sm"
                      loading="lazy"
                      data-index="${index}"
                      decoding="async"
                      style="min-height: 200px; background-color: #f3f4f6;"
                    />
                    <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-30 transition-opacity duration-300 flex items-center justify-center">
                    </div>
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        `;
        
        galleryContainer.innerHTML = gridHTML;
        
        // Progressive image loading for layout stability
        const thumbnails = document.querySelectorAll('.gallery-thumbnail');
        let imagesLoaded = 0;
        const totalImages = thumbnails.length;
        
        // Start with grid at low opacity
        setTimeout(() => {
          if (galleryContainer) {
            galleryContainer.style.opacity = '0.3';
          }
        }, 100);
        
        function imageLoaded() {
          imagesLoaded++;
          
          // Gradually increase opacity as images load
          if (galleryContainer) {
            const progress = imagesLoaded / totalImages;
            galleryContainer.style.opacity = Math.min(0.3 + (progress * 0.7), 1).toString();
            
            // Fully visible once most images are loaded
            if (progress >= 0.7) {
              galleryContainer.style.opacity = '1';
            }
          }
        }
        
        // Load high-res images progressively
        thumbnails.forEach((img) => {
          if (img instanceof HTMLImageElement) {
            const highResSrc = img.dataset.src;
            
            if (highResSrc) {
              const tempImg = new Image();
              
              tempImg.onload = function() {
                // Smoothly transition to high-res image
                img.src = highResSrc;
                img.classList.remove('blur-sm');
                img.style.filter = 'none';
                imageLoaded();
              };
              
              tempImg.onerror = function() {
                // Still count as loaded even if failed
                imageLoaded();
              };
              
              tempImg.src = highResSrc;
            } else {
              imageLoaded();
            }
          }
        });
        
        // Fallback: ensure grid is visible after 3 seconds regardless
        setTimeout(() => {
          if (galleryContainer) {
            galleryContainer.style.opacity = '1';
          }
        }, 3000);
        
        // Re-attach lightbox event listeners with improved performance
        thumbnails.forEach((thumbnail) => {
          thumbnail.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const index = parseInt(thumbnail.dataset.index);
            openLightbox(index);
          });
          
          // Also add click handler to the container div
          const container = thumbnail.closest('.group');
          if (container) {
            container.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              const index = parseInt(thumbnail.dataset.index);
              openLightbox(index);
            });
          }
        });
        
        // Preload first few images for immediate lightbox access
        preloadInitialImages();
      }
      
      // Lightbox function with progressive loading
      function openLightbox(index) {
        const lightbox = document.getElementById('lightbox');
        const image = document.getElementById('lightbox-image');
        const counter = document.getElementById('lightbox-counter');
        
        if (!lightbox || !image || !counter || !portfolioImages[index]) {
          return;
        }

        currentImageIndex = index;
        
        // Show lightbox with proper z-index and prevent scrolling
        lightbox.classList.remove('hidden');
        lightbox.style.zIndex = '9999';
        document.body.style.overflow = 'hidden';
        document.documentElement.style.overflow = 'hidden'; // Also prevent html scroll
        
        const currentImage = portfolioImages[index];
        
        // First load a low-quality placeholder for instant feedback
        const placeholderUrl = buildCloudinaryUrl(currentImage.src, { 
          width: 50,
          quality: 30,
          blur: 15
        });
        
        // Load optimized Cloudinary image for lightbox based on screen size
        const screenWidth = window.innerWidth;
        const screenHeight = window.innerHeight;
        const maxWidth = Math.min(screenWidth * window.devicePixelRatio, 1400); // Cap at 1400px
        const maxHeight = Math.min(screenHeight * window.devicePixelRatio, 900); // Cap at 900px
        
        const lightboxUrl = buildCloudinaryUrl(currentImage.src, { 
          width: Math.floor(maxWidth),
          height: Math.floor(maxHeight),
          quality: 'auto:good',
          format: 'auto',
          crop: 'fit'
        });
        
        // Show blurred placeholder first
        image.src = placeholderUrl;
        image.alt = currentImage.alt;
        image.style.opacity = '0.7';
        image.style.filter = 'blur(5px)';
        
        // Then load the high-quality image
        const highQualityImg = new Image();
        highQualityImg.onload = function() {
          image.src = lightboxUrl;
          image.style.opacity = '1';
          image.style.filter = 'none';
        };
        highQualityImg.src = lightboxUrl;
        
        // Update counter (removed title display)
        counter.textContent = `${index + 1} / ${portfolioImages.length}`;
        
        // Update navigation buttons
        updateLightboxNavigation();
        
        // Preload adjacent images for smoother navigation
        preloadAdjacentImages(index);
        
        // Focus on lightbox for keyboard navigation
        lightbox.focus();
      }      // Add preloading function for smoother navigation
      function preloadAdjacentImages(currentIndex) {
        const preloadIndices = [
          currentIndex - 1, // Previous image
          currentIndex + 1  // Next image
        ].filter(index => index >= 0 && index < portfolioImages.length);
        
        preloadIndices.forEach(index => {
          const img = new Image();
          const screenWidth = window.innerWidth;
          const maxWidth = Math.min(screenWidth * window.devicePixelRatio, 1200); // Smaller for preloading
          const preloadUrl = buildCloudinaryUrl(portfolioImages[index].src, { 
            width: Math.floor(maxWidth),
            quality: 'auto:good',
            format: 'auto',
            crop: 'fit'
          });
          img.src = preloadUrl;
        });
      }
      
      // Preload first few high-res images for immediate lightbox access
      function preloadInitialImages() {
        const firstFew = Math.min(3, portfolioImages.length);
        const screenWidth = window.innerWidth;
        const maxWidth = Math.min(screenWidth * window.devicePixelRatio, 1200); // Smaller for initial preloading
        
        for (let i = 0; i < firstFew; i++) {
          setTimeout(() => {
            const img = new Image();
            const preloadUrl = buildCloudinaryUrl(portfolioImages[i].src, { 
              width: Math.floor(maxWidth),
              quality: 'auto:good',
              format: 'auto',
              crop: 'fit'
            });
            img.src = preloadUrl;
          }, i * 100); // Stagger preloading to avoid blocking
        }
      }
      
      function updateLightboxNavigation() {
        const prevBtn = document.getElementById('lightbox-prev');
        const nextBtn = document.getElementById('lightbox-next');
        
        if (prevBtn) {
          prevBtn.style.display = currentImageIndex === 0 ? 'none' : 'block';
        }
        if (nextBtn) {
          nextBtn.style.display = currentImageIndex === portfolioImages.length - 1 ? 'none' : 'block';
        }
      }
      
      function nextImage() {
        if (currentImageIndex < portfolioImages.length - 1) {
          openLightbox(currentImageIndex + 1);
        }
      }
      
      function prevImage() {
        if (currentImageIndex > 0) {
          openLightbox(currentImageIndex - 1);
        }
      }
      
      function closeLightbox() {
        const lightbox = document.getElementById('lightbox');
        if (lightbox) {
          lightbox.classList.add('hidden');
          lightbox.style.zIndex = '';
          document.body.style.overflow = '';
          document.documentElement.style.overflow = ''; // Restore html scroll
        }
      }
      
      // Set up lightbox navigation
      let currentImageIndex = 0;
      
      // Close button
      const closeBtn = document.getElementById('lightbox-close');
      if (closeBtn) {
        closeBtn.addEventListener('click', closeLightbox);
      }
      
      // Navigation buttons
      const prevBtn = document.getElementById('lightbox-prev');
      if (prevBtn) {
        prevBtn.addEventListener('click', prevImage);
      }
      
      const nextBtn = document.getElementById('lightbox-next');
      if (nextBtn) {
        nextBtn.addEventListener('click', nextImage);
      }
      
      // Keyboard navigation
      document.addEventListener('keydown', function(e) {
        const lightbox = document.getElementById('lightbox');
        if (!lightbox || lightbox.classList.contains('hidden')) return;
        
        // Prevent default behavior for arrow keys
        if (['ArrowLeft', 'ArrowRight', 'Escape'].includes(e.key)) {
          e.preventDefault();
        }
        
        switch(e.key) {
          case 'Escape':
            closeLightbox();
            break;
          case 'ArrowLeft':
          case 'a':
          case 'A':
            prevImage();
            break;
          case 'ArrowRight':
          case 'd':
          case 'D':
            nextImage();
            break;
        }
      });
      
      // Click outside to close
      const lightbox = document.getElementById('lightbox');
      if (lightbox) {
        lightbox.addEventListener('click', function(e) {
          // Only close if clicking on the lightbox background, not on the content
          if (e.target === lightbox) {
            closeLightbox();
          }
        });
        
        // Touch/swipe support for mobile
        let startX = null;
        let startY = null;
        
        lightbox.addEventListener('touchstart', function(e) {
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
        }, { passive: true });
        
        lightbox.addEventListener('touchend', function(e) {
          if (!startX || !startY) return;
          
          const endX = e.changedTouches[0].clientX;
          const endY = e.changedTouches[0].clientY;
          
          const deltaX = endX - startX;
          const deltaY = endY - startY;
          
          // Only handle horizontal swipes (ignore vertical scrolling)
          if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 50) {
            if (deltaX > 0) {
              // Swipe right - previous image
              prevImage();
            } else {
              // Swipe left - next image  
              nextImage();
            }
          }
          
          startX = null;
          startY = null;
        }, { passive: true });
      }
      
      // Initialize gallery
      displayImages();
    });
  </script>

  <Footer />
</Layout>
