---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { cloudinaryGalleryImages } from '../data/cloudinaryImages';

const seoTitle = "drvmedia - Professional Automotive Photography";
const seoDescription = "drvmedia's professional photography portfolio featuring automotive photography, portraits, and creative visuals. Explore a diverse collection of stunning photography work.";
const seoKeywords = "drvmedia, photographer, automotive photography, portrait photography, professional photographer, photography portfolio, creative photography";

const featuredImages = cloudinaryGalleryImages.slice(0, 6);
---

<Layout 
  title={seoTitle} 
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/newlogo-dark.png"
>
  <Header />
  
  <main class="min-h-screen">
    <section class="pt-32 lg:pt-40 pb-16 lg:pb-24 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="col-span-12 lg:col-span-7 space-y-8">
            <div>
              <h1 class="text-5xl lg:text-7xl font-thin text-gray-900 mb-6 leading-tight" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.02em;">
                Capturing Motion,<br/>Defining Moments
              </h1>
              
              <p class="text-xl lg:text-2xl text-gray-600 font-thin leading-relaxed mb-8" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.01em;">
                Automotive photography that tells stories through light, form, and passion.
              </p>
              
              <div class="flex flex-col sm:flex-row gap-4 mb-12">
                <a 
                  href="/booking" 
                  class="px-8 py-4 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors text-lg font-thin tracking-wide shadow-sm hover:shadow-md"
                  style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
                >
                  Book a Session
                </a>
                <a 
                  href="/gallery" 
                  class="px-8 py-4 border border-gray-300 text-gray-700 rounded-lg hover:border-gray-400 hover:bg-gray-50 transition-colors text-lg font-thin tracking-wide"
                  style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
                >
                  View Gallery
                </a>
              </div>
            </div>
            
            <div class="space-y-6 pt-8 border-t border-gray-200">
              <h2 class="text-2xl lg:text-3xl font-thin text-gray-900" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.02em;">
                What We Do
              </h2>
              
              <div class="space-y-4 text-gray-600 text-lg leading-relaxed" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
                <p>
                  Specializing in automotive photography that captures the essence of every vehicle—from classic curves to modern engineering marvels.
                </p>
                <p>
                  We work with enthusiasts, collectors, and brands to create stunning visual narratives that showcase craftsmanship, detail, and emotion.
                </p>
                <p>
                  Every shoot is tailored to highlight what makes your vehicle unique, whether it's a track-ready build, a pristine restoration, or a daily driver with character.
                </p>
              </div>
            </div>
          </div>
          
          <div class="col-span-12 lg:col-span-5 space-y-6">
            <div class="relative overflow-hidden rounded-lg shadow-xl hover:shadow-2xl transition-shadow duration-300">
              <img 
                src={`https://res.cloudinary.com/dqrj6xsjs/image/upload/w_800,q_auto:good,f_auto,c_fill,g_auto/${featuredImages[0].src}`}
                alt={featuredImages[0].alt}
                class="w-full h-auto object-cover"
                loading="eager"
              />
            </div>
            
            <div class="grid grid-cols-2 gap-4">
              <div class="relative overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
                <img 
                  src={`https://res.cloudinary.com/dqrj6xsjs/image/upload/w_400,q_auto:good,f_auto,c_fill,g_auto/${featuredImages[1].src}`}
                  alt={featuredImages[1].alt}
                  class="w-full h-auto object-cover"
                  loading="lazy"
                />
              </div>
              <div class="relative overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
                <img 
                  src={`https://res.cloudinary.com/dqrj6xsjs/image/upload/w_400,q_auto:good,f_auto,c_fill,g_auto/${featuredImages[2].src}`}
                  alt={featuredImages[2].alt}
                  class="w-full h-auto object-cover"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </div>
        
        <div class="mt-24 lg:mt-32 grid grid-cols-12 gap-8 lg:gap-16 items-center">
          <div class="col-span-12 lg:col-span-5 order-2 lg:order-1">
            <div class="relative overflow-hidden rounded-lg shadow-xl hover:shadow-2xl transition-shadow duration-300">
              <img 
                src={`https://res.cloudinary.com/dqrj6xsjs/image/upload/w_800,q_auto:good,f_auto,c_fill,g_auto/${featuredImages[3].src}`}
                alt={featuredImages[3].alt}
                class="w-full h-auto object-cover"
                loading="lazy"
              />
            </div>
            
            <div class="grid grid-cols-2 gap-4 mt-6">
              <div class="relative overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
                <img 
                  src={`https://res.cloudinary.com/dqrj6xsjs/image/upload/w_400,q_auto:good,f_auto,c_fill,g_auto/${featuredImages[4].src}`}
                  alt={featuredImages[4].alt}
                  class="w-full h-auto object-cover"
                  loading="lazy"
                />
              </div>
              <div class="relative overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
                <img 
                  src={`https://res.cloudinary.com/dqrj6xsjs/image/upload/w_400,q_auto:good,f_auto,c_fill,g_auto/${featuredImages[5].src}`}
                  alt={featuredImages[5].alt}
                  class="w-full h-auto object-cover"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
          
          <div class="col-span-12 lg:col-span-7 order-1 lg:order-2 space-y-8">
            <h2 class="text-3xl lg:text-4xl font-thin text-gray-900 leading-tight" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.02em;">
              Built on Passion,<br/>Delivered with Precision
            </h2>
            
            <div class="space-y-6 text-gray-600 text-lg leading-relaxed" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
              <p>
                From concept to final delivery, we bring technical expertise and creative vision to every project.
              </p>
              <p>
                Our approach combines dynamic composition, natural lighting techniques, and careful post-production to deliver images that stand out.
              </p>
              <p>
                Whether you need portfolio shots for social media, professional marketing materials, or high-resolution prints, we craft visuals that make an impact.
              </p>
            </div>
            
            <div class="pt-6">
              <a 
                href="/about" 
                class="inline-flex items-center text-gray-900 hover:text-gray-600 transition-colors text-lg font-thin tracking-wide group"
                style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
              >
                Learn more about us
                <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <section class="py-16 bg-gradient-to-br from-gray-50 to-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl lg:text-4xl font-thin text-gray-900 mb-6 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
          Ready to Collaborate?
        </h2>
        <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto leading-relaxed" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
          Let's create something extraordinary together. Get in touch to discuss your project and bring your vision to life.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a 
            href="/booking" 
            class="px-8 py-4 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors text-lg font-thin tracking-wide shadow-sm hover:shadow-md"
            style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
          >
            Book a Session
          </a>
          <button 
            id="connect-btn-cta"
            class="px-8 py-4 border border-gray-300 text-gray-700 rounded-lg hover:border-gray-400 hover:bg-gray-50 transition-colors text-lg font-thin tracking-wide"
            style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
          >
            Connect
          </button>
        </div>
      </div>
    </section>
  </main>
  
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const connectBtnCta = document.getElementById('connect-btn-cta');
      
      if (connectBtnCta) {
        connectBtnCta.addEventListener('click', function() {
          const connectBtn = document.getElementById('connect-btn');
          if (connectBtn) {
            connectBtn.click();
          }
        });
      }
    });
  </script>

  <Footer />
</Layout>
