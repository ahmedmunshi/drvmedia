---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { cloudinaryGalleryImages } from '../data/cloudinaryImages';

const seoTitle = "DRV Media - Professional Automotive Photography | Lusaka, Zambia";
const seoDescription = "DRV Media specializes in professional automotive photography and videography in Lusaka, Zambia. Car photo shoots, cinematic reels, and creative automotive content for enthusiasts and dealerships.";
const seoKeywords = "DRV Media, automotive photography Lusaka, car photography Zambia, automotive videography, car photo shoot, professional car photographer, automotive content creation";

const featuredImages = cloudinaryGalleryImages.slice(0, 7);
---

<Layout 
  title={seoTitle} 
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/newlogo-dark.png"
>
  <Header />
  
  <main class="min-h-screen">
    <section class="pt-24 lg:pt-40 pb-12 lg:pb-24 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="col-span-12 lg:col-span-7 space-y-6 lg:space-y-8">
            <div>
              <h1 class="text-3xl lg:text-7xl font-thin text-gray-900 mb-3 lg:mb-6 leading-tight" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.02em;">
                Cars. Camera.<br/>Done Right.
              </h1>
              
              <p class="text-base lg:text-2xl text-gray-600 font-thin leading-relaxed mb-6 lg:mb-8" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.01em;">
                Automotive photos that do your build justice.
              </p>
              
              <div class="flex flex-col sm:flex-row gap-4 mb-8 lg:mb-12">
                <a 
                  href="/booking" 
                  class="px-8 py-4 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors text-lg font-thin tracking-wide shadow-sm hover:shadow-md"
                  style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
                >
                  Book a Session
                </a>
                <a 
                  href="/gallery" 
                  class="px-8 py-4 border border-gray-300 text-gray-700 rounded-lg hover:border-gray-400 hover:bg-gray-50 transition-colors text-lg font-thin tracking-wide"
                  style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
                >
                  View Gallery
                </a>
              </div>
            </div>
            
            <div class="space-y-6 pt-6 lg:pt-8 border-t border-gray-200">
              <h2 class="text-2xl lg:text-3xl font-thin text-gray-900" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.02em;">
                What We Do
              </h2>
              
              <div class="space-y-4 text-gray-600 text-lg leading-relaxed" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
                <p>
                  We shoot cars. Builds, classics, track monsters, whatever you've got.
                </p>
                <p>
                  Working with enthusiasts, collectors, and anyone who cares about their ride and wants photos that actually capture it.
                </p>
                <p>
                  Whether you need media and social management, prints for the wall, or content for a campaign, we'll make it happen.
                </p>
              </div>
            </div>
          </div>
          
          <div class="col-span-12 lg:col-span-5 space-y-6">
            <div class="relative overflow-hidden rounded-lg shadow-xl hover:shadow-2xl transition-shadow duration-300">
              <img 
                src="https://res.cloudinary.com/dqrj6xsjs/image/upload/w_800,q_auto:good,f_auto,c_fill,g_auto/_MG_9304_gp1j4v"
                alt="Automotive shot MG 9304"
                class="w-full h-auto object-cover"
                loading="eager"
              />
            </div>
            
            <div class="grid grid-cols-2 gap-4">
              <div class="space-y-4">
                <div class="relative overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
                  <img 
                    src="https://res.cloudinary.com/dqrj6xsjs/image/upload/w_400,q_auto:good,f_auto,c_fill,g_auto/_MG_9354_boldcr"
                    alt="Automotive shot MG 9354"
                    class="w-full h-auto object-cover"
                    loading="lazy"
                  />
                </div>
              </div>
              <div class="relative overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
                <img 
                  src="https://res.cloudinary.com/dqrj6xsjs/image/upload/w_400,q_auto:good,f_auto,c_fill,g_auto/_MG_9276_luaqpw"
                  alt="Automotive shot MG 9276"
                  class="w-full h-auto object-cover"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </div>
        
        <div class="mt-24 lg:mt-32 grid grid-cols-12 gap-8 lg:gap-16 items-center">
          <div class="col-span-12 lg:col-span-5 order-2 lg:order-1">
            <div class="relative overflow-hidden rounded-lg shadow-xl hover:shadow-2xl transition-shadow duration-300">
              <img 
                src="https://res.cloudinary.com/dqrj6xsjs/image/upload/w_800,q_auto:good,f_auto,c_fill,g_auto/_MG_0326_gkq54a"
                alt="Automotive shot MG 0326"
                class="w-full h-auto object-cover"
                loading="lazy"
              />
            </div>
            
            <div class="grid grid-cols-2 gap-4 mt-6">
              <div class="relative overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
                <img 
                  src="https://res.cloudinary.com/dqrj6xsjs/image/upload/w_400,q_auto:good,f_auto,c_fill,g_auto/_MG_0518_ik9qfh"
                  alt="Automotive shot MG 0518"
                  class="w-full h-auto object-cover"
                  loading="lazy"
                />
              </div>
              <div class="relative overflow-hidden rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
                <img 
                  src="https://res.cloudinary.com/dqrj6xsjs/image/upload/w_400,q_auto:good,f_auto,c_fill,g_auto/_MG_0544_s21n4u"
                  alt="Automotive shot MG 0544"
                  class="w-full h-auto object-cover"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
          
          <div class="col-span-12 lg:col-span-7 order-1 lg:order-2 space-y-8">
            <h2 class="text-3xl lg:text-4xl font-thin text-gray-900 leading-tight" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.02em;">
              How We Work
            </h2>
            
            <div class="space-y-6 text-gray-600 text-lg leading-relaxed" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
              <p>
                Every shoot is different. We figure out what you're going for, find the right spot, and get it done.
              </p>
              <p>
                Good lighting, solid angles, clean edits. We make your car look like its supposed to.
              </p>
            </div>
            
            <div class="pt-6">
              <a 
                href="/about" 
                class="inline-flex items-center text-gray-900 hover:text-gray-600 transition-colors text-lg font-thin tracking-wide group"
                style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
              >
                Learn more about us
                <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <section class="py-16 bg-gradient-to-br from-gray-50 to-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl lg:text-4xl font-thin text-gray-900 mb-6 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
          Let's Shoot
        </h2>
        <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto leading-relaxed" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
          Got a project in mind? Hit us up and let's talk details.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a 
            href="/booking" 
            class="px-8 py-4 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors text-lg font-thin tracking-wide shadow-sm hover:shadow-md"
            style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
          >
            Book a Session
          </a>
          <button 
            id="connect-btn-cta"
            class="px-8 py-4 border border-gray-300 text-gray-700 rounded-lg hover:border-gray-400 hover:bg-gray-50 transition-colors text-lg font-thin tracking-wide"
            style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
          >
            Connect
          </button>
        </div>
      </div>
    </section>
  </main>
  
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const connectBtnCta = document.getElementById('connect-btn-cta');
      
      if (connectBtnCta) {
        connectBtnCta.addEventListener('click', function() {
          const connectBtn = document.getElementById('connect-btn');
          if (connectBtn) {
            connectBtn.click();
          }
        });
      }
    });
  </script>

  <Footer />
</Layout>
