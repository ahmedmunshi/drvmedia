                <svg class="w-5 h-5 text-gray-400 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                Handling All Photo Logistics from Capturing to Posting
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Volume Discounts Section -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-thin text-gray-900 mb-4 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
            Volume Discounts
          </h2>
        </div>
        
        <div class="bg-gray-50 rounded-lg p-8 shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead>
                <tr class="border-b border-gray-200">
                  <th class="pb-4 text-lg font-semibold text-gray-900" style="font-family: 'Poppins', sans-serif; font-weight: 600;">Cars/Month</th>
