---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// SEO optimized metadata
const seoTitle = "Late Optics Pricing - Professional Automotive Photography Packages";
const seoDescription = "Explore Late Optics professional automotive photography pricing packages. Creative shoots, inventory photography, and custom packages for automotive photography needs.";
const seoKeywords = "Late Optics pricing, automotive photography packages, car photography rates, creative shoots, inventory photography pricing, professional automotive photographer costs";
---

<Layout 
  title={seoTitle} 
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/newlogo-dark.png"
>
  <Header />
  
  <main class="min-h-screen bg-gray-50">
    <!-- Mobile Navigation -->
    <div id="mobile-nav" class="lg:hidden fixed top-16 left-0 right-0 z-50 bg-white shadow-sm transition-transform duration-300">
      <div class="flex justify-center space-x-4 px-4 py-3">
        <a 
          href="/" 
          class="px-4 py-2 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-md text-sm font-thin tracking-wide transition-colors"
          style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
        >
          Gallery
        </a>
        <a 
          href="/about" 
          class="px-4 py-2 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-md text-sm font-thin tracking-wide transition-colors"
          style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
        >
          About
        </a>
        <button class="px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-thin tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;">
          Pricing
        </button>
      </div>
    </div>

    <!-- Pricing Hero Section -->
    <section class="py-24 lg:py-32 pt-40 lg:pt-32 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-4xl md:text-5xl font-thin text-gray-900 mb-8 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
            Late Optics — 2025 Packages
          </h1>
          <p class="text-lg text-gray-600 mb-12 max-w-3xl mx-auto" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
            Professional automotive photography services tailored to your vision and needs.
          </p>
        </div>
      </div>
    </section>

    <!-- Creative Shoots Section -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-thin text-gray-900 mb-4 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
            Creative Shoots
          </h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
          <!-- Full Package -->
          <div class="bg-gray-50 rounded-lg p-8 shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-2xl font-semibold text-gray-900 mb-4" style="font-family: 'Poppins', sans-serif; font-weight: 600;">
              Full Package
            </h3>
            <div class="text-3xl font-thin text-gray-900 mb-6" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
              K5,000
            </div>
            <ul class="space-y-3 text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-gray-400 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                Cinematic Colour Graded Reel
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-gray-400 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                Instagram Ready (Vertical & Horizontal Formats)
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-gray-400 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                10–15 Professionally Edited Photos
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-gray-400 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                1–2 Different Locations
              </li>
            </ul>
          </div>

          <!-- Reel Only -->
          <div class="bg-gray-50 rounded-lg p-8 shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-2xl font-semibold text-gray-900 mb-4" style="font-family: 'Poppins', sans-serif; font-weight: 600;">
              Reel Only
            </h3>
            <div class="text-3xl font-thin text-gray-900 mb-6" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
              K2,700
            </div>
            <ul class="space-y-3 text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-gray-400 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                Cinematic Colour Graded Reel
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-gray-400 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                Socials Ready (Vertical & Horizontal Formats)
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-gray-400 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                1–2 Different Locations
              </li>
            </ul>
          </div>

          <!-- Photos Only -->
          <div class="bg-gray-50 rounded-lg p-8 shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-2xl font-semibold text-gray-900 mb-4" style="font-family: 'Poppins', sans-serif; font-weight: 600;">
              Photos Only
            </h3>
            <div class="text-3xl font-thin text-gray-900 mb-6" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
              K1,500
            </div>
            <ul class="space-y-3 text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-gray-400 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
