                  <td class="py-4 text-gray-900 font-medium" style="font-family: 'Poppins', sans-serif;">K1,800/Car</td>
                </tr>
                <tr class="border-b border-gray-100">
                  <td class="py-4 text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">20+ Cars</td>
                  <td class="py-4 text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">15% off</td>
                  <td class="py-4 text-gray-900 font-medium" style="font-family: 'Poppins', sans-serif;">K750/Car</td>
