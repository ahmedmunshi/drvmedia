---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const seoTitle = "Get a Quote - DRV Media Professional Automotive Photography";
const seoDescription = "Request a custom quote for your automotive photography project. Professional car photography, videography, and creative content services in Lusaka, Zambia.";
const seoKeywords = "automotive photography quote, car photography pricing, DRV Media quote, professional photography Lusaka, custom photography packages";
---

<Layout 
  title={seoTitle} 
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/newlogo-dark.png"
>
  <Header />
  
  <main class="min-h-screen pt-16">
    <!-- Hero Section -->
    <section class="pt-16 pb-12 bg-gradient-to-br from-gray-50 to-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h1 class="text-4xl lg:text-5xl font-thin text-gray-900 mb-6 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
            Get a Quote
          </h1>
          <p class="text-xl text-gray-600 leading-relaxed max-w-2xl mx-auto" style="font-family: 'Poppins', sans-serif; font-weight: 300;">
            Tell us about your project and we'll get back to you with a custom quote.
          </p>
        </div>
      </div>
    </section>

    <!-- Quote Form Section -->
    <section class="py-16">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Success Message (Hidden by default) -->
        <div id="success-message" class="hidden mb-8 p-6 bg-green-50 border border-green-200 rounded-lg">
          <div class="flex items-center">
            <svg class="w-6 h-6 text-green-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <h3 class="text-lg font-medium text-green-800" style="font-family: 'Poppins', sans-serif;">Thank you for your inquiry!</h3>
              <p class="text-green-700 mt-1" style="font-family: 'Poppins', sans-serif; font-weight: 300;">We'll get back to you within 24 hours with a custom quote.</p>
            </div>
          </div>
        </div>

        <!-- Error Message (Hidden by default) -->
        <div id="error-message" class="hidden mb-8 p-6 bg-red-50 border border-red-200 rounded-lg">
          <div class="flex items-center">
            <svg class="w-6 h-6 text-red-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <h3 class="text-lg font-medium text-red-800" style="font-family: 'Poppins', sans-serif;">Something went wrong</h3>
              <p class="text-red-700 mt-1" style="font-family: 'Poppins', sans-serif; font-weight: 300;">Please try again or contact us directly at ahmed@drv-media.com</p>
            </div>
          </div>
        </div>

        <!-- Quote Form -->
        <form 
          id="quote-form"
          class="bg-white rounded-xl shadow-sm border border-gray-200 p-8"
        >
          
          <!-- Contact Information -->
          <div class="mb-10">
            <h2 class="text-2xl font-thin text-gray-900 mb-6 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
              Contact Information
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-2" style="font-family: 'Poppins', sans-serif;">
                  Full Name *
                </label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent-400 focus:border-transparent transition-all duration-200" 
                  style="font-family: 'Poppins', sans-serif; font-weight: 300;"
                  placeholder="Your full name"
                />
              </div>
              
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-2" style="font-family: 'Poppins', sans-serif;">
                  Email Address *
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent-400 focus:border-transparent transition-all duration-200" 
                  style="font-family: 'Poppins', sans-serif; font-weight: 300;"
                  placeholder="your@email.com"
                />
              </div>
              
              <div class="md:col-span-2">
                <label for="phone" class="block text-sm font-medium text-gray-700 mb-2" style="font-family: 'Poppins', sans-serif;">
                  Phone Number
                </label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent-400 focus:border-transparent transition-all duration-200" 
                  style="font-family: 'Poppins', sans-serif; font-weight: 300;"
                  placeholder="+260 XXX XXX XXXX"
                />
              </div>
            </div>
          </div>

          <!-- Project Details -->
          <div class="mb-10">
            <h2 class="text-2xl font-thin text-gray-900 mb-6 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
              Project Details
            </h2>
            
            <div class="space-y-6">
              <div>
                <label for="project-type" class="block text-sm font-medium text-gray-700 mb-2" style="font-family: 'Poppins', sans-serif;">
                  Type of Project *
                </label>
                <select 
                  id="project-type" 
                  name="projectType" 
                  required 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent-400 focus:border-transparent transition-all duration-200" 
                  style="font-family: 'Poppins', sans-serif; font-weight: 300;"
                >
                  <option value="">Select a project type</option>
                  <option value="creative-shoot">Creative Photo/Video Shoot</option>
                  <option value="inventory">Inventory / Dealership Photography</option>
                  <option value="event-coverage">Event Coverage</option>
                  <option value="commercial">Commercial / Campaign</option>
                  <option value="other">Other (please specify)</option>
                </select>
              </div>
              
              <div>
                <label for="timeline" class="block text-sm font-medium text-gray-700 mb-2" style="font-family: 'Poppins', sans-serif;">
                  When do you need this? *
                </label>
                <select 
                  id="timeline" 
                  name="timeline" 
                  required 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent-400 focus:border-transparent transition-all duration-200" 
                  style="font-family: 'Poppins', sans-serif; font-weight: 300;"
                >
                  <option value="">Select timeline</option>
                  <option value="asap">ASAP</option>
                  <option value="2-weeks">Within 2 weeks</option>
                  <option value="1-month">Within a month</option>
                  <option value="2-3-months">2-3 months</option>
                  <option value="flexible">Timeline is flexible</option>
                </select>
              </div>
              
              <div>
                <label for="project-details" class="block text-sm font-medium text-gray-700 mb-2" style="font-family: 'Poppins', sans-serif;">
                  Tell us about your project *
                </label>
                <textarea 
                  id="project-details" 
                  name="projectDetails" 
                  required 
                  rows="6" 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent-400 focus:border-transparent transition-all duration-200 resize-vertical" 
                  style="font-family: 'Poppins', sans-serif; font-weight: 300;"
                  placeholder="Describe what you're looking for - the style, number of vehicles, location preferences, deliverables needed (photos, video, reels), and any other details that would help us understand your vision..."
                ></textarea>
              </div>
              
              <div>
                <label for="referral" class="block text-sm font-medium text-gray-700 mb-2" style="font-family: 'Poppins', sans-serif;">
                  How did you hear about us?
                </label>
                <select 
                  id="referral" 
                  name="referral" 
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent-400 focus:border-transparent transition-all duration-200" 
                  style="font-family: 'Poppins', sans-serif; font-weight: 300;"
                >
                  <option value="">Select an option</option>
                  <option value="instagram">Instagram</option>
                  <option value="google">Google Search</option>
                  <option value="referral">Friend/Family Referral</option>
                  <option value="event">Saw you at an event</option>
                  <option value="other">Other</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="flex flex-col sm:flex-row gap-4 items-center justify-between pt-8 border-t border-gray-200">
            <p class="text-sm text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 300;">
              We'll respond within 24 hours
            </p>
            <button 
              type="submit" 
              id="submit-btn"
              class="w-full sm:w-auto px-8 py-3 bg-accent-500 text-white rounded-lg hover:bg-gray-900 focus:ring-2 focus:ring-accent-400 focus:ring-offset-2 transition-all duration-200 font-medium tracking-wide disabled:opacity-50 disabled:cursor-not-allowed" 
              style="font-family: 'Poppins', sans-serif; font-weight: 300; letter-spacing: 0.04em;"
            >
              <span id="submit-text">Get My Quote</span>
              <svg id="submit-spinner" class="hidden inline-block w-5 h-5 ml-2 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>
        </form>

        <!-- Additional Contact Info -->
        <div class="mt-12 text-center">
          <p class="text-gray-600 mb-4" style="font-family: 'Poppins', sans-serif; font-weight: 300;">
            Prefer to reach out directly?
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a 
              href="mailto:ahmed@drv-media.com" 
              class="flex items-center px-6 py-3 border border-gray-300 rounded-lg hover:border-accent-400 hover:bg-gray-50 transition-all duration-200"
            >
              <svg class="w-5 h-5 text-gray-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              <span class="text-gray-700" style="font-family: 'Poppins', sans-serif; font-weight: 300;">ahmed@drv-media.com</span>
            </a>
            <a 
              href="https://instagram.com/drvmedia" 
              target="_blank"
              class="flex items-center px-6 py-3 border border-gray-300 rounded-lg hover:border-accent-400 hover:bg-gray-50 transition-all duration-200"
            >
              <svg class="w-5 h-5 text-gray-600 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span class="text-gray-700" style="font-family: 'Poppins', sans-serif; font-weight: 300;">@drvmedia</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <!-- EmailJS Script -->
  <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
  <script>
    emailjs.init("LcYIzdrE038Y9kiZD");
  </script>
  
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('quote-form');
      const submitBtn = document.getElementById('submit-btn');
      const submitText = document.getElementById('submit-text');
      const submitSpinner = document.getElementById('submit-spinner');
      const successMessage = document.getElementById('success-message');
      const errorMessage = document.getElementById('error-message');
      
      // Form validation
      function validateForm() {
        const requiredFields = form.querySelectorAll('[required]');
        let isValid = true;
        
        requiredFields.forEach(field => {
          if (!field.value.trim()) {
            isValid = false;
            field.classList.add('border-red-500');
          } else {
            field.classList.remove('border-red-500');
          }
        });
        
        return isValid;
      }
      
      // Real-time validation
      form.addEventListener('input', function(e) {
        if (e.target.hasAttribute('required') && e.target.value.trim()) {
          e.target.classList.remove('border-red-500');
        }
      });
      
      // Form submission
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Hide previous messages
        successMessage.classList.add('hidden');
        errorMessage.classList.add('hidden');
        
        // Validate form
        if (!validateForm()) {
          errorMessage.querySelector('p').textContent = 'Please fill in all required fields.';
          errorMessage.classList.remove('hidden');
          return;
        }
        
        // Show loading state
        submitBtn.disabled = true;
        submitText.textContent = 'Sending...';
        submitSpinner.classList.remove('hidden');
        
        try {
          const formData = new FormData(form);
          
          // Send email using EmailJS
          const result = await emailjs.send(
            'service_yxsl69o',
            'template_r2ajl5d',
            {
              from_name: formData.get('name'),
              from_email: formData.get('email'),
              phone: formData.get('phone') || 'Not provided',
              project_type: formData.get('projectType'),
              timeline: formData.get('timeline'),
              referral: formData.get('referral') || 'Not specified',
              message: formData.get('projectDetails'),
              time: new Date().toLocaleString('en-US', {
                timeZone: 'Africa/Lusaka',
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
              })
            }
          );
          
          console.log('Email sent successfully:', result);
          
          // Show success message
          successMessage.classList.remove('hidden');
          form.reset();
          
          // Scroll to success message
          successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
          
        } catch (error) {
          console.error('Form submission error:', error);
          errorMessage.classList.remove('hidden');
          
          // Scroll to error message
          errorMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } finally {
          // Reset button state
          submitBtn.disabled = false;
          submitText.textContent = 'Get My Quote';
          submitSpinner.classList.add('hidden');
        }
      });
    });
  </script>

  <Footer />
</Layout>
