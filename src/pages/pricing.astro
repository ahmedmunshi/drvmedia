                  <th class="pb-4 text-lg font-semibold text-gray-900" style="font-family: 'Poppins', sans-serif; font-weight: 600;">Rate (Package 1)</th>
                  <th class="pb-4 text-lg font-semibold text-gray-900" style="font-family: 'Poppins', sans-serif; font-weight: 600;">Rate (Package 2)</th>
                </tr>
              </thead>
              <tbody class="space-y-4">
                <tr class="border-b border-gray-100">
                  <td class="py-4 text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">10+ Cars</td>
                  <td class="py-4 text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">10% off</td>
