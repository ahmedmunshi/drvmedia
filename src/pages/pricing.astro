              K500
            </div>
            <p class="text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
              24hr Turnaround
            </p>
          </div>

          <!-- Travel Fee -->
          <div class="bg-white rounded-lg p-8 shadow-sm hover:shadow-md transition-shadow text-center">
            <h3 class="text-xl font-semibold text-gray-900 mb-4" style="font-family: 'Poppins', sans-serif; font-weight: 600;">
              Travel Fee
            </h3>
            <div class="text-2xl font-thin text-gray-900 mb-4" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
              K250
            </div>
            <p class="text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
              Flat Fee
            </p>
          </div>

          <!-- Reel Add-On -->
          <div class="bg-white rounded-lg p-8 shadow-sm hover:shadow-md transition-shadow text-center">
            <h3 class="text-xl font-semibold text-gray-900 mb-4" style="font-family: 'Poppins', sans-serif; font-weight: 600;">
              Reel Add-On
            </h3>
