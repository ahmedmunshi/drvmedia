---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ImageGrid from '../components/ImageGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import { cloudinaryGalleryImages } from '../data/cloudinaryImages';

// Use Cloudinary images
const galleryImages = cloudinaryGalleryImages;

// SEO optimized metadata
const seoTitle = "DRV Media Gallery - Automotive Photography Collection";
const seoDescription = "Browse DRV Media complete automotive photography gallery featuring professional car photography, automotive art, and creative automotive visuals from DRV Media.";
const seoKeywords = "DRVMedia gallery, DRV Media portfolio, automotive photography gallery, car photography collection, automotive art gallery, professional automotive photos";
---

<Layout 
  title={seoTitle} 
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/newlogo-dark.png"
>
  <Header />
  
  <main class="min-h-screen">
    <!-- Gallery Section Header -->
    <section class="py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">DRVMedia Gallery</h1>
          <p class="text-lg text-gray-600">Professional Automotive Photography Collection</p>
        </div>
      </div>
    </section>

    <!-- Gallery Grid -->
    <section class="pb-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ImageGrid images={galleryImages} />
      </div>
    </section>

    <!-- Lightbox Component -->
    <Lightbox images={galleryImages} />
  </main>
</Layout>
