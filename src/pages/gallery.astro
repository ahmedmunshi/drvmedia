---

<Layout title="Gallery - imlateonrent" description="Browse through my automotive photography collection">
  <Header />
  
  <main class="min-h-screen">
    <!-- Gallery Section Header -->
    <section class="py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Automotive Photography Gallery
          </h1>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            A curated collection of automotive photography showcasing the beauty and power of automobiles.
          </p>
        </div>
      </div>
    </section>

    <!-- Gallery Grid -->
    <section class="pb-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div id="gallery-container">
          <ImageGrid images={galleryImages} />
        </div>
      </div>
    </section>
  </main>
  
  <Lightbox images={galleryImages} />
  
  <script define:vars={{ galleryImages }}>
    document.addEventListener('DOMContentLoaded', function() {
      const galleryContainer = document.getElementById('gallery-container');
      
      function displayImages() {
        // Create new ImageGrid HTML - show all automotive images
        const gridHTML = `
          <div class="columns-1 md:columns-2 lg:columns-3 xl:columns-4 gap-6 space-y-6">
            ${galleryImages.map((image, index) => `
              <div class="break-inside-avoid group cursor-pointer overflow-hidden rounded-lg shadow-md hover:shadow-xl transition-all duration-300 transform hover:scale-[1.02]">
                <div class="relative bg-gray-100">
                  <img
                    src="${image.src}"
                    alt="${image.alt}"
                    class="gallery-thumbnail w-full h-auto object-cover transition-transform duration-300"
                    loading="lazy"
                    data-index="${index}"
                  />
                  <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-30 transition-opacity duration-300 flex items-center justify-center">
                    <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 text-center">
                      <svg class="w-12 h-12 text-white mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
            `).join('')}
          </div>
        `;
        
        galleryContainer.innerHTML = gridHTML;
        
        // Re-attach lightbox event listeners
        setTimeout(() => {
          const thumbnails = document.querySelectorAll('.gallery-thumbnail');
          thumbnails.forEach((thumbnail) => {
            thumbnail.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              const index = parseInt(thumbnail.dataset.index);
              // Trigger lightbox opening (this will be handled by the existing lightbox script)
            });
          });
        }, 100);
      }
      
      // Initialize gallery display
      displayImages();
    });
  </script>
</Layout>
