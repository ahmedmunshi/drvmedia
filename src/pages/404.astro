---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Page Not Found - imlateonrent">
  <Header />
  
  <main class="min-h-screen flex items-center justify-center">
    <div class="text-center px-4">
      <div class="max-w-md mx-auto">
        <div class="mb-8">
          <svg class="mx-auto h-24 w-24 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6 0a6 6 0 106 6m-6-6a6 6 0 016-6m-6 6h6"></path>
          </svg>
        </div>
        
        <h1 class="text-6xl font-bold text-gray-900 mb-4">404</h1>
        <h2 class="text-2xl font-semibold text-gray-700 mb-4">Page Not Found</h2>
        <p class="text-gray-600 mb-8">
          The page you're looking for doesn't seem to exist. Perhaps it was moved or you've typed the wrong URL.
        </p>
        
        <div class="space-y-4">
          <a 
            href="/" 
            class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-gray-900 hover:bg-gray-800 transition-colors"
          >
            Go Home
          </a>
          <div>
            <a 
              href="/gallery" 
              class="text-gray-600 hover:text-gray-900 mr-6"
            >
              View Gallery
            </a>
            <a 
              href="/about" 
              class="text-gray-600 hover:text-gray-900"
            >
              About Me
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
