---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const seoTitle = "DRV Media — Instagram Growth Retainer";
const seoDescription = "DRV Media Instagram Growth Retainer package with monthly reel production, strategy, and optional ads management.";
const seoKeywords = "DRV Media retainer, Instagram growth, reel production, social media strategy, Lusaka";
---

<Layout 
  title={seoTitle} 
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/newlogo-dark.png"
>
  <Header />

  <main class="min-h-screen pt-24 pb-16">
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8" id="retainer-print">
      <div class="print-logo hidden text-center mb-6">
        <img src="/mediaagency.png" alt="DRV Media" class="h-20 mx-auto" />
      </div>
      <div class="text-center mb-10">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-thin text-gray-900 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
          DRV Media — Instagram Growth Retainer
        </h1>
        <p class="mt-4 text-xl sm:text-2xl text-gray-700" style="font-family: 'Poppins', sans-serif; font-weight: 300;">
          K25,000 / Month
        </p>
      </div>

      <div class="border-t border-gray-200 my-8"></div>

      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-thin text-gray-900 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
          Reel Production
        </h2>
        <p class="mt-3 text-lg text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 300;">
          8 Reels Per Month
        </p>
      </div>

      <div class="border-t border-gray-200 my-8"></div>

      <section class="mb-10">
        <h2 class="text-xl sm:text-2xl font-thin text-gray-900 tracking-wide mb-6" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
          Reel Type Split
        </h2>
        <div class="space-y-5">
          <div>
            <h3 class="text-lg text-gray-900" style="font-family: 'Poppins', sans-serif; font-weight: 500;">
              4 Cinematic Showcase Reels
            </h3>
            <p class="text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 300;">
              Premium, brand-driven edits with elevated visuals and movement.
            </p>
          </div>
          <div>
            <h3 class="text-lg text-gray-900" style="font-family: 'Poppins', sans-serif; font-weight: 500;">
              4 Dealer-Style Review Reels
            </h3>
            <p class="text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 300;">
              Feature-focused, sales-oriented content highlighting key specs and value.
            </p>
          </div>
        </div>
      </section>

      <div class="border-t border-gray-200 my-8"></div>

      <section class="mb-10">
        <h2 class="text-xl sm:text-2xl font-thin text-gray-900 tracking-wide mb-6" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
          Strategy
        </h2>
        <ul class="space-y-3 text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 300;">
          <li>• Structured monthly content plan</li>
          <li>• Brand positioning direction</li>
          <li>• Hook optimisation for stronger retention</li>
          <li>• Competitor observation & market alignment</li>
        </ul>
      </section>

      <div class="border-t border-gray-200 my-8"></div>

      <section>
        <h2 class="text-xl sm:text-2xl font-thin text-gray-900 tracking-wide mb-6" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
          Add-Ons (Optional)
        </h2>
        <div class="space-y-3 text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 300;">
          <p class="text-gray-900" style="font-weight: 500;">
            Instagram / Meta Ads Management — K7,500 / Month
          </p>
          <p>
            Campaign setup, targeting, optimisation & performance summary.
          </p>
          <p>
            Ad spend separate.
          </p>
        </div>
      </section>
    </section>
  </main>

  <style>
    @media print {
      body {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      #main-header,
      #connect-overlay,
      #connect-sidebar,
      footer,
      .no-print {
        display: none !important;
      }

      .print-logo {
        display: block !important;
      }

      main {
        padding-top: 1.5rem !important;
        padding-bottom: 2rem !important;
      }
    }
  </style>

  <Footer />
</Layout>
