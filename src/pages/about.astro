---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// SEO optimized metadata
const seoTitle = "About DRV Media - Professional Photography & Videography Services";
const seoDescription = "DRV Media specializes in automotive photography and videography, portraits, and event coverage. Professional visual content services based in Lusaka, Zambia.";
const seoKeywords = "DRV Media, professional photography, professional videography, automotive photography, automotive videography, event coverage, portrait photography, Lusaka photographer";
---

<Layout 
  title={seoTitle} 
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/newlogo-dark.png"
>
  <Header />
  
  <main class="min-h-screen bg-gray-50">
    <!-- Mobile Navigation - Gallery and About buttons that disappear on scroll -->
    <div id="mobile-nav" class="lg:hidden fixed top-16 left-0 right-0 z-50 bg-white shadow-sm transition-transform duration-300">
      <div class="flex justify-center space-x-4 px-4 py-3">
        <!-- Gallery button -->
        <a 
          href="/" 
          class="px-4 py-2 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-md text-sm font-thin tracking-wide transition-colors"
          style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;"
        >
          Gallery
        </a>
        <!-- About button (current page) -->
        <button class="px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-thin tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.06em;">
          About
        </button>
      </div>
    </div>

    <!-- About Hero Section -->
    <section class="py-24 lg:py-32 pt-40 lg:pt-32 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-4xl md:text-5xl font-thin text-gray-900 mb-8 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
            About Us
          </h1>
          <p class="text-lg text-gray-600 mb-8 max-w-3xl mx-auto" style="font-family: 'Poppins', sans-serif; font-weight: 300;">
            DRV Media is a professional photography and videography service based in Lusaka, specializing in automotive content, portraits, and event coverage.
          </p>
          <p class="text-lg text-gray-600 mb-12 max-w-3xl mx-auto" style="font-family: 'Poppins', sans-serif; font-weight: 300;">
            We deliver high-quality visual content for clients who demand precision and creativity.
          </p>
          
          <!-- Visual Separator -->
          <div class="flex items-center justify-center mt-12 mb-8">
            <div class="flex-grow border-t border-gray-300 max-w-32"></div>
            <div class="mx-4">
              <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
            </div>
            <div class="flex-grow border-t border-gray-300 max-w-32"></div>
          </div>
          
          <!-- Let's Connect Section -->
          <div>
            <h2 class="text-3xl font-thin text-gray-900 mb-4 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">Let's Connect</h2>
            <p class="text-lg text-gray-600 mb-8" style="font-family: 'Poppins', sans-serif; font-weight: 300;">
              Want to work together? Reach out.
            </p>
            
            <!-- Get a Quote CTA -->
            <div class="mb-12">
              <a 
                href="/pricing" 
                class="inline-block px-8 py-4 bg-accent-500 text-white rounded-lg hover:bg-gray-900 transition-colors text-lg tracking-wide shadow-sm hover:shadow-md"
                style="font-family: 'Poppins', sans-serif; font-weight: 300; letter-spacing: 0.04em;"
              >
                Get a Quote
              </a>
              <p class="text-sm text-gray-500 mt-3" style="font-family: 'Poppins', sans-serif; font-weight: 300;">
                Got a shoot in mind? Let's talk.
              </p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-2xl mx-auto">
              <div class="text-center">
                <h3 class="text-lg font-medium text-gray-900 mb-2" style="font-family: 'Poppins', sans-serif;">Email</h3>
                <a href="mailto:ahmed@drv-media.com" class="text-gray-600 hover:text-gray-900 transition-colors" style="font-family: 'Poppins', sans-serif; font-weight: 200;">ahmed@drv-media.com</a>
              </div>

              <div class="text-center">
                <h3 class="text-lg font-medium text-gray-900 mb-2" style="font-family: 'Poppins', sans-serif;">Instagram</h3>
                <a href="https://instagram.com/drvmedia" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900 transition-colors" style="font-family: 'Poppins', sans-serif; font-weight: 200;">@drvmedia</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const mobileNav = document.getElementById('mobile-nav');
      const NAV_HIDE_PIXEL = 100; // When to hide mobile navigation
      
      // Scroll animation for mobile navigation
      function handleScroll() {
        const scrolled = window.scrollY;
        
        // Mobile navigation hide behavior
        if (mobileNav) {
          if (scrolled > NAV_HIDE_PIXEL) {  
            mobileNav.style.transform = 'translateY(-100%)';
          } else {
            mobileNav.style.transform = 'translateY(0)';
          }
        }
      }
      
      // Add scroll listener
      window.addEventListener('scroll', handleScroll);
    });
  </script>

  <Footer />
</Layout> 
