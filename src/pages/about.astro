---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="About - imlateonrent" description="Learn more about the photographer behind imlateonrent">
  <Header />
  
  <main class="min-h-screen">
    <!-- Mobile Navigation - Gallery and About buttons that disappear on scroll -->
    <div id="mobile-nav" class="lg:hidden fixed top-16 left-0 right-0 z-50 bg-white shadow-sm transition-transform duration-300">
      <div class="flex justify-center space-x-4 px-4 py-3">
        <!-- Gallery button -->
        <a 
          href="/" 
          class="px-4 py-2 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-md text-sm font-medium transition-colors"
        >
          Gallery
        </a>
        <!-- About button (current page) -->
        <button class="px-4 py-2 bg-gray-900 text-white rounded-md text-sm font-medium">
          About
        </button>
      </div>
    </div>

    <!-- About Hero Section -->
    <section class="py-24 lg:py-32 pt-40 lg:pt-32 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-8">
            About Me
          </h1>
          <p class="text-lg text-gray-600 mb-8 max-w-3xl mx-auto">
            Hi, I'm Ahmed Munshi, the photographer behind @lateoptics.
          </p>
          <p class="text-lg text-gray-600 mb-8 max-w-3xl mx-auto">
            I specialize in automotive photography.
          </p>
          <p class="text-lg text-gray-600 max-w-3xl mx-auto">
            When I'm not behind the camera, you can find me exploring new locations, planning the next shoot, 
            or sharing my work with the photography community on Instagram.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="bg-gray-100 py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Let's Connect</h2>
          <p class="text-lg text-gray-600">
            Interested in collaboration? Feel free to reach out.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="text-center">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Email</h3>
            <p class="text-gray-600">lateoptics@gmail.com</p>
          </div>

          <div class="text-center">
            
            <p class="text-lg font-semibold text-gray-900 mb-2">Instagram</p>
            <a href="https://instagram.com/lateoptics" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900 transition-colors">@lateoptics</a>
          </div>
        
      </div>
    </section>
  </main>
  
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const mobileNav = document.getElementById('mobile-nav');
      const NAV_HIDE_PIXEL = 100; // When to hide mobile navigation
      
      // Scroll animation for mobile navigation
      function handleScroll() {
        const scrolled = window.scrollY;
        
        // Mobile navigation hide behavior
        if (mobileNav) {
          if (scrolled > NAV_HIDE_PIXEL) {  
            mobileNav.style.transform = 'translateY(-100%)';
          } else {
            mobileNav.style.transform = 'translateY(0)';
          }
        }
      }
      
      // Add scroll listener
      window.addEventListener('scroll', handleScroll);
    });
  </script>
</Layout> 
