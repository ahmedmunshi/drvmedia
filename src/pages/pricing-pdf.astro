---
// PDF-optimized pricing page without header, footer, or navigation
const seoTitle = "DRV Media Pricing - Professional Automotive Photography & Videography Packages";
const seoDescription = "Professional automotive photography and videography pricing packages. Creative shoots, inventory content, and custom packages for automotive needs.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{seoTitle}</title>
  <meta name="description" content={seoDescription} />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Tailwind CSS -->
  <link href="/dist/output.css" rel="stylesheet">
  
  <style>
    /* PDF-optimized styles */
    body {
      font-family: 'Poppins', sans-serif;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    
    /* Optimize for print/PDF */
    @media print {
      .break-inside-avoid {
        page-break-inside: avoid;
      }
      
      .shadow-sm {
        box-shadow: none;
        border: 1px solid #e5e7eb;
      }
    }
    
    /* Remove interactive elements for PDF */
    .no-hover {
      transition: none;
    }
    
    .no-hover:hover {
      transform: none;
      box-shadow: inherit;
    }
  </style>
</head>

<body class="bg-white text-gray-900 p-8">
  <main class="max-w-6xl mx-auto">
    
    <!-- Header Section -->
    <section class="mb-16 text-center break-inside-avoid">
      <h1 class="text-4xl md:text-5xl font-thin text-gray-900 mb-6 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
        DRV Media — 2025 Packages
      </h1>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
        Professional automotive photography and videography services tailored to your vision and needs.
      </p>
    </section>

    <!-- Creative Shoots Section -->
    <section class="mb-16 break-inside-avoid">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-thin text-gray-900 mb-4 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
          Creative Shoots
        </h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <!-- Full Package -->
        <div class="bg-gray-50 rounded-lg p-6 shadow-sm no-hover break-inside-avoid">
          <h3 class="text-xl font-semibold text-gray-900 mb-3" style="font-family: 'Poppins', sans-serif; font-weight: 600;">
            Full Package
          </h3>
          <div class="text-2xl font-thin text-gray-900 mb-4" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
            K4,000
          </div>
          <ul class="space-y-2 text-sm text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              Cinematic Colour Graded Reel
            </li>
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              Instagram Ready (Vertical or Horizontal Formats)
            </li>
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              10–15 Professionally Edited Photos
            </li>
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              1–2 Different Locations
            </li>
          </ul>
        </div>

        <!-- Video Only -->
        <div class="bg-gray-50 rounded-lg p-6 shadow-sm no-hover break-inside-avoid">
          <h3 class="text-xl font-semibold text-gray-900 mb-3" style="font-family: 'Poppins', sans-serif; font-weight: 600;">
            Video Only
          </h3>
          <div class="text-2xl font-thin text-gray-900 mb-4" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
            K2,700
          </div>
          <ul class="space-y-2 text-sm text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              Cinematic Colour Graded Reel
            </li>
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              Socials Ready (Vertical or Horizontal Formats)
            </li>
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              1–2 Different Locations
            </li>
          </ul>
        </div>

        <!-- Photos Only -->
        <div class="bg-gray-50 rounded-lg p-6 shadow-sm no-hover break-inside-avoid">
          <h3 class="text-xl font-semibold text-gray-900 mb-3" style="font-family: 'Poppins', sans-serif; font-weight: 600;">
            Photos Only
          </h3>
          <div class="text-2xl font-thin text-gray-900 mb-4" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
            K1,500
          </div>
          <ul class="space-y-2 text-sm text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              Stylistically Edited Photo Set
            </li>
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              10–15 Professionally Edited Photos
            </li>
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              1–2 Different Locations
            </li>
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              Includes Rollers
            </li>
          </ul>
        </div>
      </div>

      <div class="text-center">
        <p class="text-sm text-gray-500" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
          <strong>NOTE:</strong> Custom packages can be created upon request.
        </p>
      </div>
    </section>

    <!-- Inventory Shoots Section -->
    <section class="mb-16 break-inside-avoid">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-thin text-gray-900 mb-4 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
          Inventory Shoots
        </h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <!-- Standard Package -->
        <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm no-hover break-inside-avoid">
          <h3 class="text-xl font-semibold text-gray-900 mb-3" style="font-family: 'Poppins', sans-serif; font-weight: 600;">
            Standard Package
          </h3>
          <div class="text-2xl font-thin text-gray-900 mb-4" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
            K1,200<span class="text-base text-gray-500">/Car</span>
          </div>
          <ul class="space-y-2 text-sm text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              10 Edited Photos per Car
            </li>
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              Optimized for Posting Directly on Social Media
            </li>
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              48-Hour Delivery
            </li>
          </ul>
        </div>

        <!-- Inventory + Social Media Management -->
        <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm no-hover break-inside-avoid">
          <h3 class="text-xl font-semibold text-gray-900 mb-3" style="font-family: 'Poppins', sans-serif; font-weight: 600;">
            Inventory + Social Media Management
          </h3>
          <div class="text-2xl font-thin text-gray-900 mb-4" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
            K2,000<span class="text-base text-gray-500">/Car</span>
          </div>
          <ul class="space-y-2 text-sm text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              10 Photos with Curated Captions and Hashtags
            </li>
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              Optimized to Maximize Visibility
            </li>
            <li class="flex items-start">
              <span class="text-gray-400 mr-2">✓</span>
              Handling All Photo Logistics from Capturing to Posting
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Volume Discounts Section -->
    <section class="mb-16 break-inside-avoid">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-thin text-gray-900 mb-4 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
          Volume Discounts
        </h2>
      </div>
      
      <div class="bg-gray-50 rounded-lg p-6 shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="pb-3 font-semibold text-gray-900" style="font-family: 'Poppins', sans-serif; font-weight: 600;">Cars/Month</th>
                <th class="pb-3 font-semibold text-gray-900" style="font-family: 'Poppins', sans-serif; font-weight: 600;">Discount</th>
                <th class="pb-3 font-semibold text-gray-900" style="font-family: 'Poppins', sans-serif; font-weight: 600;">Rate (Package 1)</th>
                <th class="pb-3 font-semibold text-gray-900" style="font-family: 'Poppins', sans-serif; font-weight: 600;">Rate (Package 2)</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-gray-100">
                <td class="py-3 text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">10+ Cars</td>
                <td class="py-3 text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">10% off</td>
                <td class="py-3 text-gray-900 font-medium" style="font-family: 'Poppins', sans-serif;">K1,080/Car</td>
                <td class="py-3 text-gray-900 font-medium" style="font-family: 'Poppins', sans-serif;">K1,800/Car</td>
              </tr>
              <tr class="border-b border-gray-100">
                <td class="py-3 text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">20+ Cars</td>
                <td class="py-3 text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">15% off</td>
                <td class="py-3 text-gray-900 font-medium" style="font-family: 'Poppins', sans-serif;">K1,020/Car</td>
                <td class="py-3 text-gray-900 font-medium" style="font-family: 'Poppins', sans-serif;">K1,700/Car</td>
              </tr>
              <tr>
                <td class="py-3 text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">30+ Cars</td>
                <td class="py-3 text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">20% off</td>
                <td class="py-3 text-gray-900 font-medium" style="font-family: 'Poppins', sans-serif;">K960/Car</td>
                <td class="py-3 text-gray-900 font-medium" style="font-family: 'Poppins', sans-serif;">K1,600/Car</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-xs text-gray-500 mt-4" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
          (Discount only applies to signed retainers or contracts guaranteeing the specified amount of vehicles.)
        </p>
      </div>
    </section>

    <!-- Add-Ons Section -->
    <section class="mb-16 break-inside-avoid">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-thin text-gray-900 mb-4 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
          Add-Ons
        </h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Express Delivery -->
        <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm no-hover text-center break-inside-avoid">
          <h3 class="text-lg font-semibold text-gray-900 mb-3" style="font-family: 'Poppins', sans-serif; font-weight: 600;">
            Express Delivery
          </h3>
          <div class="text-xl font-thin text-gray-900 mb-3" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
            K500
          </div>
          <p class="text-sm text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
            24hr Turnaround
          </p>
        </div>


        <!-- Reel Add-On -->
        <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm no-hover text-center break-inside-avoid">
          <h3 class="text-lg font-semibold text-gray-900 mb-3" style="font-family: 'Poppins', sans-serif; font-weight: 600;">
            Reel Add-On
          </h3>
          <div class="text-xl font-thin text-gray-900 mb-3" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
            K1,000
          </div>
          <p class="text-sm text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
            Add Reel to Assigned Photo Shoot (Only Dealerships)
          </p>
        </div>
      </div>
      

    </section>

    <!-- Booking Information Section -->
    <section class="mb-8 break-inside-avoid">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-thin text-gray-900 mb-4 tracking-wide" style="font-family: 'Poppins', sans-serif; font-weight: 200; letter-spacing: 0.03em;">
          Booking Information
        </h2>
      </div>
      
      <div class="bg-gray-50 rounded-lg p-6 shadow-sm">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-3" style="font-family: 'Poppins', sans-serif; font-weight: 600;">
              Payment Terms
            </h3>
            <ul class="space-y-1 text-sm text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
              <li>• 50% Deposit Required to Confirm Shoot</li>
              <li>• Balance Due After Final Delivery</li>
            </ul>
          </div>
          
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-3" style="font-family: 'Poppins', sans-serif; font-weight: 600;">
              Delivery & Timeline
            </h3>
            <ul class="space-y-1 text-sm text-gray-600" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
              <li>• Standard Turnaround: 24–48 Hours for Photos</li>
              <li>• All Deliverables Provided in an Organized Google Drive Folder</li>
              <li>• Includes Web & High-Res Versions</li>
              <li>• Travel Fee: K250 (locations outside standard service area)</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Copyright -->
    <section class="text-center py-4 border-t border-gray-200">
      <p class="text-xs text-gray-500" style="font-family: 'Poppins', sans-serif; font-weight: 200;">
        © 2025 DRV Media | All Rights Reserved
      </p>
    </section>

  </main>
</body>
</html>