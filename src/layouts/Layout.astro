---
export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonical?: string;
}

const { 
  title = "DRV Media - Professional Automotive Photography", 
  description = "DRV Media professional automotive photography and videography services in Lusaka, Zambia. Stunning car photography, automotive content, and creative visuals.",
  keywords = "DRV Media, drvmedia, automotive photography, car photography, Lusaka photographer, Zambia automotive photography, car videography, automotive content",
  ogImage = "/newlogo-dark.png",
  canonical = Astro.url.href
} = Astro.props;

const siteUrl = Astro.site?.toString() || 'https://drv-media.netlify.app';
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const logoUrl = new URL('/newlogo-dark.png', siteUrl).toString();

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "DRV Media",
  "alternateName": "DRVMedia",
  "url": siteUrl,
  "logo": logoUrl,
  "image": logoUrl,
  "description": "Professional automotive photography and videography services specializing in car photography, automotive content, and creative visuals.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Lusaka",
    "addressCountry": "ZM"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -15.3875,
    "longitude": 28.3228
  },
  "priceRange": "$$",
  "telephone": "",
  "email": "ahmed@drv-media.com",
  "sameAs": [
    "https://instagram.com/drvmedia"
  ],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "opens": "08:00",
    "closes": "18:00"
  },
  "serviceArea": {
    "@type": "Place",
    "name": "Lusaka, Zambia"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Automotive Photography Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Creative Car Photography",
          "description": "Professional automotive photo shoots with cinematic editing"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Automotive Videography",
          "description": "Cinematic car videos and reels for social media"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Inventory Photography",
          "description": "Professional dealership and inventory photography"
        }
      }
    ]
  }
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="DRV Media" />
    <link rel="canonical" href={canonical} />
    
    <!-- Geographic Targeting -->
    <meta name="geo.region" content="ZM-09" />
    <meta name="geo.placename" content="Lusaka" />
    <meta name="geo.position" content="-15.3875;28.3228" />
    <meta name="ICBM" content="-15.3875, 28.3228" />
    
    <!-- Brand Recognition -->
    <meta name="brand" content="DRV Media" />
    <meta name="application-name" content="DRV Media" />
    <meta name="apple-mobile-web-app-title" content="DRV Media" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="DRV Media" />
    <meta property="og:locale" content="en_ZM" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content="@drvmedia" />
    <meta name="twitter:creator" content="@drvmedia" />
    
    <!-- Schema.org structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    
    <!-- Icons and Manifest -->
    <link rel="icon" type="image/png" href="/mediaagency.png" />
    <link rel="apple-touch-icon" href="/mediaagency.png" />
    <link rel="shortcut icon" href="/mediaagency.png" />
    
    <!-- Fonts with preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&family=Nunito+Sans:ital,wght@0,200;0,300;0,400;0,600;0,700;0,800;0,900;1,200;1,300;1,400;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    
    <!-- Cloudinary preconnect for faster image loading -->
    <link rel="preconnect" href="https://res.cloudinary.com">
    
    <style>
      /* Critical CSS to prevent layout shifts */
      .gallery-thumbnail {
        width: 100%;
        height: auto;
        min-height: 200px;
        background-color: #f3f4f6;
        object-fit: cover;
      }
      
      /* Smooth transitions for image loading */
      #image-grid,
      #gallery-container {
        will-change: opacity;
        transition: opacity 0.5s ease;
      }
      
      /* Prevent flash of unstyled content */
      .columns-1 {
        column-fill: balance;
      }
      
      /* Mobile-specific masonry optimizations to prevent jumping */
      @media (max-width: 640px) {
        .columns-1 {
          column-gap: 0.75rem;
        }
        
        .break-inside-avoid {
          margin-bottom: 0.75rem;
          min-height: 200px; /* Prevent extreme height jumps */
        }
        
        .gallery-thumbnail {
          min-height: 200px;
          max-height: 500px; /* Prevent extreme tall images on mobile */
          object-fit: cover;
        }
      }
      
      /* Optimize rendering performance */
      img {
        image-rendering: -webkit-optimize-contrast;
        image-rendering: crisp-edges;
      }
      
      /* Better spacing for masonry layout */
      .break-inside-avoid {
        break-inside: avoid;
        page-break-inside: avoid;
        margin-bottom: 1.5rem;
      }
      
      /* Ensure proper column gaps */
      @media (min-width: 640px) {
        .columns-2 {
          column-gap: 1rem;
        }
      }
      
      @media (min-width: 768px) {
        .columns-2 {
          column-gap: 1.5rem;
        }
      }
      
      @media (min-width: 1024px) {
        .columns-3 {
          column-gap: 1.5rem;
        }
      }
      
      @media (min-width: 1280px) {
        .columns-4 {
          column-gap: 1.5rem;
        }
      }
    </style>
  </head>
  <body class="bg-white text-gray-900" style="font-family: 'Poppins', sans-serif;">
    <slot />
  </body>
</html>
