---
export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonical?: string;
}

const { 
  title = "Late Optics - Professional Automotive Photography", 
  description = "LateO ptics professional automotive photography portfolio featuring stunning car photography, automotive art, and creative automotive visuals.",
  keywords = "Late Optics, automotive photography, car photography, professional automotive photographer, automotive art, car photos, automotive visuals, late optics photography",
  ogImage = "/image.png",
  canonical = Astro.url.href
} = Astro.props;

const siteUrl = Astro.site || 'https://lateoptics.netlify.app';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="LateOptics" />
    <link rel="canonical" href={canonical} />
    
    <!-- Brand Recognition -->
    <meta name="brand" content="LateOptics" />
    <meta name="application-name" content="LateOptics" />
    <meta name="apple-mobile-web-app-title" content="LateOptics" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="LateOptics" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl)} />
    <meta name="twitter:site" content="@lateoptics" />
    <meta name="twitter:creator" content="@lateoptics" />
    
    <!-- Business Information -->
    <meta name="business:contact_data:locality" content="Photography" />
    <meta name="business:contact_data:region" content="Automotive" />
    <meta name="business:contact_data:country_name" content="Professional" />
    
    <!-- Schema.org structured data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "LateOptics",
        "alternateName": "Late Optics",
        "url": "{siteUrl}",
        "logo": "{new URL('/image.png', siteUrl)}",
        "sameAs": [
          "https://instagram.com/lateoptics",
          "https://twitter.com/lateoptics"
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer service",
          "availableLanguage": "en"
        },
        "description": "Professional automotive photography services specializing in stunning car photography and automotive art."
      }
    </script>
    
    <!-- Icons and Manifest -->
    <link rel="icon" type="image/png" href="/image.png" />
    <link rel="apple-touch-icon" href="/image.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    
    <!-- Fonts with preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Cloudinary preconnect for faster image loading -->
    <link rel="preconnect" href="https://res.cloudinary.com">
    
    <style>
      /* Critical CSS to prevent layout shifts */
      .gallery-thumbnail {
        width: 100%;
        height: auto;
        min-height: 200px;
        background-color: #f3f4f6;
        object-fit: cover;
      }
      
      /* Smooth transitions for image loading */
      #image-grid {
        will-change: opacity;
      }
      
      /* Prevent flash of unstyled content */
      .columns-1 {
        column-fill: balance;
      }
      
      /* Optimize rendering performance */
      img {
        image-rendering: -webkit-optimize-contrast;
        image-rendering: crisp-edges;
      }
      
      /* Better spacing for masonry layout */
      .break-inside-avoid {
        break-inside: avoid;
        page-break-inside: avoid;
        margin-bottom: 1.5rem;
      }
      
      /* Ensure proper column gaps */
      @media (min-width: 768px) {
        .columns-2 {
          column-gap: 1.5rem;
        }
      }
      
      @media (min-width: 1024px) {
        .columns-3 {
          column-gap: 1.5rem;
        }
      }
      
      @media (min-width: 1280px) {
        .columns-4 {
          column-gap: 1.5rem;
        }
      }
    </style>
  </head>
  <body class="bg-white text-gray-900" style="font-family: 'Poppins', sans-serif;">
    <slot />
  </body>
</html>
